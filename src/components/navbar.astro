---

<nav class="navbar" aria-label="Navegación principal">
  <div class="nav-container">
    <div class="nav-brand">
      <a href="/init" class="logo-flex">
        <div class="logo-icon logo-icon--data" aria-hidden="true"></div>
        <span class="logo-text">Sistema de inventario</span>
      </a>
    </div>

    <div class="nav-menus">
      <!-- Operación: tablas y cargas -->
      <div class="nav-group nav-group--data">
        <span class="nav-label">Base de datos</span>
        <div class="nav-group-links">
          <a href="/inven">Inventario</a>
          <a href="/productos">Productos</a>
          <a href="/up_inven">Subir inventario</a>
          <a href="/trabajadores">Trabajadores</a>
          <a href="/up_trabajador">Subir trabajadores</a>
          <a href="/negocios">Negocios</a>
        </div>
      </div>

      <div class="nav-divider" aria-hidden="true"></div>

      <!-- Análisis: solo lectura / gráficos -->
      <div class="nav-group nav-group--reports">
        <span class="nav-label nav-label--reports">Análisis</span>
        <div class="nav-group-links">
          <a href="/reportes" class="nav-link-report">Reportes inventario</a>
          <a href="/reportes_trabajadores" class="nav-link-report">Reportes nómina</a>
        </div>
      </div>
    </div>
  </div>
</nav>

<style>
  :root {
    --nav-bg: rgba(255, 255, 255, 0.92);
    --nav-border: rgba(226, 232, 240, 0.8);
    --text-primary: #0f172a;
    --data-accent: #0ea5e9;
    --report-accent: #7c3aed;
    --report-accent-soft: rgba(124, 58, 237, 0.12);
  }

  .navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--nav-bg);
    backdrop-filter: blur(18px) saturate(180%);
    -webkit-backdrop-filter: blur(18px) saturate(180%);
    border-bottom: 1px solid var(--nav-border);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.6) inset, 0 4px 24px rgba(15, 23, 42, 0.06);
  }

  .nav-container {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 14px 24px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
  }

  .nav-brand {
    display: flex;
    align-items: center;
    min-width: 200px;
  }

  .logo-flex {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    transition: transform 0.2s;
  }
  .logo-flex:hover {
    transform: translateY(-1px);
  }

  .logo-icon {
    width: 36px;
    height: 36px;
    border-radius: 12px;
    flex-shrink: 0;
  }
  .logo-icon--data {
    background: linear-gradient(135deg, #38bdf8 0%, #0ea5e9 45%, #0284c7 100%);
    box-shadow: 0 6px 16px rgba(14, 165, 233, 0.35);
  }

  .logo-text {
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text-primary);
  }

  .nav-menus {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 16px 24px;
    justify-content: flex-end;
    flex: 1;
    min-width: 0;
  }

  .nav-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  .nav-group--data .nav-group-links a {
    color: #475569;
  }
  .nav-group--data .nav-group-links a:hover {
    color: #0284c7;
    background: rgba(14, 165, 233, 0.08);
  }

  .nav-group--reports {
    padding: 10px 14px;
    border-radius: 16px;
    background: linear-gradient(145deg, var(--report-accent-soft) 0%, rgba(255, 255, 255, 0.6) 100%);
    border: 1px solid rgba(124, 58, 237, 0.18);
    box-shadow: 0 4px 14px rgba(124, 58, 237, 0.08);
  }

  .nav-label {
    font-size: 0.65rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #94a3b8;
  }

  .nav-label--reports {
    color: #6d28d9;
  }

  .nav-group-links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
  }

  .nav-group-links a {
    text-decoration: none;
    font-weight: 600;
    font-size: 0.8125rem;
    padding: 8px 12px;
    border-radius: 10px;
    transition: color 0.15s, background 0.15s, transform 0.15s;
    white-space: nowrap;
  }

  .nav-link-report {
    color: #5b21b6 !important;
    background: rgba(255, 255, 255, 0.65);
    border: 1px solid rgba(124, 58, 237, 0.22);
    font-weight: 700;
  }
  .nav-link-report:hover {
    color: #4c1d95 !important;
    background: #fff;
    border-color: rgba(124, 58, 237, 0.4);
    transform: translateY(-1px);
    box-shadow: 0 6px 14px rgba(124, 58, 237, 0.15);
  }

  .nav-divider {
    width: 1px;
    min-height: 44px;
    align-self: center;
    background: linear-gradient(180deg, transparent, #e2e8f0 20%, #e2e8f0 80%, transparent);
    display: none;
  }

  @media (min-width: 900px) {
    .nav-divider {
      display: block;
    }
  }

  @media (max-width: 899px) {
    .nav-menus {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
    }
    .nav-group--reports {
      order: -1;
    }
  }
</style>
