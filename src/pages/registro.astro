<!doctype html>
<html lang="es-co">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Crear Cuenta — Acceso a tu Plataforma</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: "Inter", sans-serif;
        background: #020617;
        color: #e2e8f0;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        overflow: hidden;
      }

      /* Background */
      .bg {
        position: fixed;
        inset: 0;
        z-index: 0;
        background: radial-gradient(
          ellipse at 30% 50%,
          #0f172a 0%,
          #020617 70%
        );
      }
      .blob {
        position: absolute;
        border-radius: 50%;
        filter: blur(100px);
        opacity: 0.2;
        animation: drift 18s infinite alternate ease-in-out;
      }
      .blob-1 {
        width: 500px;
        height: 500px;
        background: #1e3a8a;
        top: -20%;
        left: -10%;
      }
      .blob-2 {
        width: 400px;
        height: 400px;
        background: #4c1d95;
        bottom: -10%;
        right: -5%;
        animation-delay: -9s;
      }
      @keyframes drift {
        from {
          transform: translate(0, 0) scale(1);
        }
        to {
          transform: translate(60px, 40px) scale(1.06);
        }
      }

      /* Card */
      .card {
        position: relative;
        z-index: 1;
        background: rgba(15, 23, 42, 0.85);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 24px;
        padding: 40px 36px;
        width: 100%;
        max-width: 440px;
        backdrop-filter: blur(20px);
        box-shadow: 0 25px 60px rgba(0, 0, 0, 0.5);
        animation: appear 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
      }
      @keyframes appear {
        from {
          opacity: 0;
          transform: translateY(24px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      /* Logo / badge */
      .badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: linear-gradient(135deg, #7c3aed, #4f46e5);
        color: white;
        font-size: 0.7rem;
        font-weight: 700;
        padding: 5px 12px;
        border-radius: 999px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        margin-bottom: 20px;
      }

      h1 {
        font-size: 1.6rem;
        font-weight: 800;
        color: #f1f5f9;
        margin-bottom: 8px;
        letter-spacing: -0.03em;
      }
      .subtitle {
        font-size: 0.875rem;
        color: #64748b;
        margin-bottom: 28px;
        line-height: 1.6;
      }
      .empresa-name {
        color: #c4b5fd;
        font-weight: 700;
      }

      /* Fields */
      .field {
        display: flex;
        flex-direction: column;
        gap: 6px;
        margin-bottom: 16px;
      }
      .field label {
        font-size: 0.78rem;
        font-weight: 600;
        color: #94a3b8;
      }
      .field input {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 10px;
        padding: 12px 14px;
        color: #f1f5f9;
        font-size: 0.9rem;
        font-family: inherit;
        width: 100%;
        transition:
          border-color 0.2s,
          box-shadow 0.2s;
      }
      .field input:focus {
        outline: none;
        border-color: #7c3aed;
        box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.15);
      }
      .field input::placeholder {
        color: #475569;
      }

      /* Button */
      .btn-submit {
        width: 100%;
        padding: 13px;
        background: linear-gradient(135deg, #7c3aed, #4f46e5);
        color: white;
        border: none;
        border-radius: 12px;
        font-size: 0.95rem;
        font-weight: 700;
        cursor: pointer;
        font-family: inherit;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(124, 58, 237, 0.35);
        margin-top: 8px;
      }
      .btn-submit:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(124, 58, 237, 0.45);
      }
      .btn-submit:disabled {
        opacity: 0.6;
        cursor: not-allowed;
      }

      /* Messages */
      .msg {
        padding: 12px 16px;
        border-radius: 10px;
        font-size: 0.85rem;
        font-weight: 600;
        margin-top: 16px;
        display: none;
      }
      .msg.error {
        background: rgba(239, 68, 68, 0.1);
        border: 1px solid rgba(239, 68, 68, 0.3);
        color: #fca5a5;
        display: block;
      }
      .msg.success {
        background: rgba(74, 222, 128, 0.1);
        border: 1px solid rgba(74, 222, 128, 0.3);
        color: #4ade80;
        display: block;
      }

      /* Error — empresa inválida */
      .invalid-card {
        text-align: center;
        padding: 20px 0;
      }
      .invalid-card .icon {
        font-size: 3rem;
        margin-bottom: 16px;
      }
      .invalid-card h2 {
        color: #f87171;
        font-size: 1.1rem;
        margin-bottom: 8px;
      }
      .invalid-card p {
        color: #64748b;
        font-size: 0.875rem;
      }

      .login-link {
        text-align: center;
        margin-top: 20px;
        font-size: 0.82rem;
        color: #475569;
      }
      .login-link a {
        color: #8b5cf6;
        font-weight: 600;
        text-decoration: none;
      }
      .login-link a:hover {
        text-decoration: underline;
      }
    </style>
  </head>
  <body>
    <div class="bg">
      <div class="blob blob-1"></div>
      <div class="blob blob-2"></div>
    </div>

    <div class="card" id="card">
      <div style="text-align:center; padding: 40px 0; color: #475569;">
        Verificando enlace...
      </div>
    </div>

    <script>
      import { supabase } from "../lib/supabase";

      const card = document.getElementById("card")!;

      // Leer empresa_id y rol de la URL
      const params = new URLSearchParams(window.location.search);
      const empresaId = params.get("empresa");
      const rolParam  = params.get("rol") || "admin"; // default: admin
      const rolLabel  = rolParam === "trabajador" ? "Trabajador" : "Administrador";

      // Renderiza el formulario
      function renderForm(empresaNombre: string) {
        card.innerHTML = `
          <div class="badge">✦ Registro de cuenta</div>
          <h1>Bienvenido a tu plataforma</h1>
          <p class="subtitle">
            Estás creando una cuenta de <span class="empresa-name">${rolLabel}</span> para
            <span class="empresa-name">${empresaNombre}</span>.
          </p>

          <div class="field">
            <label for="inp-nombre">Nombre completo</label>
            <input id="inp-nombre" type="text" placeholder="Ej: Juan Pérez" />
          </div>
          <div class="field">
            <label for="inp-email">Correo electrónico</label>
            <input id="inp-email" type="email" placeholder="tu@correo.com" autocomplete="email" />
          </div>
          <div class="field">
            <label for="inp-pass">Contraseña</label>
            <input id="inp-pass" type="password" placeholder="Mínimo 6 caracteres" autocomplete="new-password" />
          </div>
          <div class="field">
            <label for="inp-pass2">Confirmar contraseña</label>
            <input id="inp-pass2" type="password" placeholder="Repite tu contraseña" autocomplete="new-password" />
          </div>

          <button class="btn-submit" id="btn-registrar">Crear mi cuenta →</button>
          <div class="msg" id="msg-result"></div>

          <div class="login-link">
            ¿Ya tienes cuenta? <a href="/">Iniciar sesión</a>
          </div>
        `;

        document
          .getElementById("btn-registrar")!
          .addEventListener("click", handleRegister);
      }

      // Renderiza error de enlace inválido
      function renderInvalid() {
        card.innerHTML = `
          <div class="invalid-card">
            <div class="icon">🔗</div>
            <h2>Enlace inválido o expirado</h2>
            <p>Este enlace de registro no es válido. Por favor contacta a tu proveedor para obtener un enlace correcto.</p>
          </div>
        `;
      }

      // Manejar registro
      async function handleRegister() {
        const nombre = (
          document.getElementById("inp-nombre") as HTMLInputElement
        ).value.trim();
        const email = (
          document.getElementById("inp-email") as HTMLInputElement
        ).value.trim();
        const pass = (document.getElementById("inp-pass") as HTMLInputElement)
          .value;
        const pass2 = (document.getElementById("inp-pass2") as HTMLInputElement)
          .value;
        const btn = document.getElementById(
          "btn-registrar",
        ) as HTMLButtonElement;
        const msg = document.getElementById("msg-result")!;

        msg.className = "msg";
        msg.textContent = "";

        if (!nombre) {
          showMsg("Ingresa tu nombre completo.", true);
          return;
        }
        if (!email) {
          showMsg("Ingresa tu correo electrónico.", true);
          return;
        }
        if (pass.length < 6) {
          showMsg("La contraseña debe tener al menos 6 caracteres.", true);
          return;
        }
        if (pass !== pass2) {
          showMsg("Las contraseñas no coinciden.", true);
          return;
        }

        btn.disabled = true;
        btn.textContent = "Creando cuenta...";

        try {
          // 1. Crear usuario — el trigger en Supabase crea el perfil automáticamente
          const { data, error: signUpError } = await supabase.auth.signUp({
            email,
            password: pass,
            options: {
              data: {
                empresa_id: empresaId,
                role: rolParam,
                nombre: nombre,
              },
            },
          });

          if (signUpError) throw signUpError;
          if (!data.user) throw new Error("No se pudo crear el usuario.");

          // 2. Si hay sesión activa (sin confirmación de email) → ir al panel
          if (data.session) {
            showMsg("✅ ¡Cuenta creada! Redirigiendo a tu panel...", false);
            btn.textContent = "¡Listo!";
            setTimeout(() => window.location.replace("/init"), 1800);
          } else {
            // Email confirmation habilitado → avisar al usuario
            showMsg(
              "📧 Cuenta creada. Revisa tu correo y confirma tu email para iniciar sesión.",
              false,
            );
            btn.textContent = "Revisa tu correo";
          }
        } catch (e: any) {
          btn.disabled = false;
          btn.textContent = "Crear mi cuenta →";
          showMsg("Error: " + (e.message || "Inténtalo nuevamente."), true);
        }
      }

      function showMsg(text: string, isError: boolean) {
        const msg = document.getElementById("msg-result")!;
        msg.textContent = text;
        msg.className = `msg ${isError ? "error" : "success"}`;
      }

      // Inicializar
      async function init() {
        if (!empresaId) {
          renderInvalid();
          return;
        }

        // Verificar que la empresa existe y está activa
        const { data, error } = await supabase
          .from("empresas")
          .select("nombre, activo")
          .eq("id", empresaId)
          .single();

        if (error || !data || !data.activo) {
          renderInvalid();
          return;
        }

        renderForm(data.nombre);
      }

      init();
    </script>
  </body>
</html>
