<!DOCTYPE html>
<html lang="es-co">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Inicio de sesión" />
    <title>Inventario | Login</title>
  </head>
  <body>
    <div class="login-page">
      <div class="background-blobs">
        <div class="blob blob-1"></div>
        <div class="blob blob-2"></div>
        <div class="blob blob-3"></div>
      </div>
      
      <div class="login-container">
        <div class="login-card">
          <div class="brand">
            <h1 class="logo-text">Sistema de Inventario</h1>
            <p class="subtitle">Accede a tu panel de control</p>
          </div>
          
          <form id="login-form" class="login-form">
            <div class="input-group">
              <label for="usuario">Usuario (Correo)</label>
              <input
                type="email"
                id="usuario"
                name="email"
                autocomplete="email"
                placeholder="ejemplo@correo.com"
                required
              />
            </div>
            
            <div class="input-group">
              <label for="password">Contraseña</label>
              <input
                type="password"
                id="password"
                name="password"
                autocomplete="current-password"
                placeholder="••••••••"
                required
              />
            </div>
            
            <button type="submit" class="login-btn">
              <span>Iniciar sesión</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </button>
          </form>
          
          <p id="error-msg" class="error-msg"></p>
        </div>
        
        <p class="footer-text">&copy; 2026 Sistema de Gestión de Inventario</p>
      </div>
    </div>

    <style>
      :root {
        --bg-dark: #0f172a;
        --card-bg: rgba(30, 41, 59, 0.7);
        --white: #ffffff;
        --text-dim: #94a3b8;
        --accent: #3b82f6;
        --accent-hover: #2563eb;
        --accent-light: #60a5fa;
        --error: #ef4444;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background-color: var(--bg-dark);
        color: var(--white);
        overflow: hidden;
      }

      .login-page {
        position: relative;
        height: 100vh;
        width: 100vw;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: hidden;
      }

      /* Background animated blobs */
      .background-blobs {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 1;
        overflow: hidden;
      }

      .blob {
        position: absolute;
        border-radius: 50%;
        filter: blur(80px);
        opacity: 0.5;
        animation: float 20s infinite alternate ease-in-out;
      }

      .blob-1 {
        width: 400px;
        height: 400px;
        background: #1d4ed8;
        top: -100px;
        left: -100px;
      }

      .blob-2 {
        width: 300px;
        height: 300px;
        background: #7e22ce;
        bottom: -50px;
        right: -50px;
        animation-delay: -5s;
      }

      .blob-3 {
        width: 250px;
        height: 250px;
        background: #0369a1;
        top: 40%;
        left: 30%;
        animation-delay: -10s;
      }

      @keyframes float {
        0% { transform: translate(0, 0) scale(1); }
        100% { transform: translate(100px, 50px) scale(1.1); }
      }

      .login-container {
        position: relative;
        z-index: 2;
        width: 100%;
        max-width: 420px;
        padding: 20px;
      }

      .login-card {
        background: var(--card-bg);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 24px;
        padding: 40px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
      }

      .brand {
        text-align: center;
        margin-bottom: 32px;
      }

      .logo-text {
        font-size: 2rem;
        font-weight: 800;
        letter-spacing: -0.025em;
        background: linear-gradient(135deg, #fff 0%, #94a3b8 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin-bottom: 8px;
      }

      .subtitle {
        color: var(--text-dim);
        font-size: 0.95rem;
      }

      .login-form {
        display: flex;
        flex-direction: column;
        gap: 20px;
      }

      .input-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
      }

      .input-group label {
        font-size: 0.85rem;
        font-weight: 500;
        color: var(--text-dim);
        margin-left: 4px;
      }

      .input-group input {
        background: rgba(15, 23, 42, 0.5);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        padding: 12px 16px;
        color: var(--white);
        font-size: 1rem;
        transition: all 0.2s ease;
      }

      .input-group input:focus {
        outline: none;
        border-color: var(--accent);
        box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1);
        background: rgba(15, 23, 42, 0.8);
      }

      .login-btn {
        margin-top: 12px;
        background: linear-gradient(135deg, var(--accent) 0%, #2563eb 100%);
        color: white;
        border: none;
        border-radius: 12px;
        padding: 14px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: all 0.2s ease;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
      }

      .login-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 15px -3px rgba(59, 130, 246, 0.3);
        filter: brightness(1.1);
      }

      .login-btn:active {
        transform: translateY(0);
      }

      .error-msg {
        color: var(--error);
        font-size: 0.85rem;
        text-align: center;
        margin-top: 16px;
        padding: 10px;
        background: rgba(239, 68, 68, 0.1);
        border-radius: 8px;
        display: none;
      }

      .footer-text {
        text-align: center;
        margin-top: 24px;
        color: var(--text-dim);
        font-size: 0.8rem;
      }

      @media (max-width: 480px) {
        .login-card {
          padding: 32px 24px;
        }
        .logo-text {
          font-size: 1.75rem;
        }
      }
    </style>
    
    <script>
      import { signInUser } from "../lib/auth";

      const form = document.getElementById("login-form");
      const emailInput = document.getElementById("usuario") as HTMLInputElement;
      const passInput = document.getElementById("password") as HTMLInputElement;
      const errorMsg = document.getElementById("error-msg");

      form?.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (errorMsg) {
          errorMsg.style.display = "none";
          errorMsg.textContent = "";
        }

        const submitBtn = form.querySelector('button[type="submit"]');
        if (submitBtn) {
          submitBtn.setAttribute('disabled', 'true');
          const originalContent = submitBtn.innerHTML;
          submitBtn.innerHTML = '<span>Iniciando sesión...</span>';

          try {
            await signInUser(emailInput.value, passInput.value);
            window.location.href = "../init";
          } catch (error: any) {
            submitBtn.removeAttribute('disabled');
            submitBtn.innerHTML = originalContent;
            
            if (errorMsg) {
              errorMsg.textContent = "Error: " + (error.message || "Usuario o contraseña inválidos");
              errorMsg.style.display = "block";
            }
          }
        }
      });
    </script>
  </body>
</html>

