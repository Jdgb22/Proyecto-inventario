<!doctype html>
<html lang="es-co">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Accede al Sistema de Inventario" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>Inventario | Iniciar Sesión</title>
  </head>
  <body>
    <div class="login-wrapper">
      <!-- Animated Mesh Background -->
      <div class="mesh-bg">
        <div class="mesh-blob mesh-1"></div>
        <div class="mesh-blob mesh-2"></div>
        <div class="mesh-blob mesh-3"></div>
      </div>

      <main class="login-container">
        <div class="login-card">
          <header class="brand-header">
            <div class="logo-icon">📦</div>
            <h1 class="logo-title">Gestión de Inventario</h1>
            <p class="logo-subtitle">Accede a tu panel central</p>
          </header>

          <form id="login-form" class="form-content">
            <div class="form-group">
              <label for="usuario">Correo Electrónico</label>
              <input
                type="email"
                id="usuario"
                name="email"
                autocomplete="email"
                placeholder="nombre@empresa.com"
                required
              />
            </div>

            <div class="form-group">
              <label for="password">Contraseña</label>
              <input
                type="password"
                id="password"
                name="password"
                autocomplete="current-password"
                placeholder="••••••••"
                required
              />
            </div>

            <button type="submit" id="submit-btn" class="submit-button">
              <span>Entrar al Sistema</span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M5 12h14M12 5l7 7-7 7"></path></svg
              >
            </button>
          </form>

          <div id="error-box" class="alert-box"></div>
        </div>

        <footer class="login-footer">
          <p>&copy; 2026 Plataforma de Inventario Centralizado</p>
        </footer>
      </main>
    </div>

    <style>
      :root {
        --primary: #2563eb;
        --primary-dark: #1d4ed8;
        --primary-light: #60a5fa;
        --bg-deep: #020617;
        --slate-200: #e2e8f0;
        --slate-400: #94a3b8;
        --slate-500: #64748b;
        --white: #ffffff;
        --error: #ef4444;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: "Inter", sans-serif;
        background-color: var(--bg-deep);
        color: var(--white);
        line-height: 1.5;
        overflow: hidden;
      }

      .login-wrapper {
        position: relative;
        min-height: 100vh;
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        background: radial-gradient(
          circle at 50% 50%,
          #0f172a 0%,
          #020617 100%
        );
      }

      /* Animated Mesh */
      .mesh-bg {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
        z-index: 1;
      }

      .mesh-blob {
        position: absolute;
        border-radius: 50%;
        filter: blur(100px);
        opacity: 0.4;
        animation: rotateMove 25s infinite alternate ease-in-out;
      }

      .mesh-1 {
        width: 500px;
        height: 500px;
        background: #1e3a8a;
        top: -10%;
        left: -5%;
      }

      .mesh-2 {
        width: 400px;
        height: 400px;
        background: #312e81;
        bottom: -5%;
        right: -5%;
        animation-delay: -7s;
      }

      .mesh-3 {
        width: 300px;
        height: 300px;
        background: #1e40af;
        top: 40%;
        left: 30%;
        animation-delay: -12s;
      }

      @keyframes rotateMove {
        0% {
          transform: translate(0, 0) rotate(0deg);
        }
        100% {
          transform: translate(150px, 100px) rotate(90deg);
        }
      }

      .login-container {
        position: relative;
        z-index: 10;
        width: 100%;
        max-width: 440px;
        padding: 24px;
        animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1);
      }

      @keyframes fadeInUp {
        from {
          opacity: 0;
          transform: translateY(20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .login-card {
        background: rgba(15, 23, 42, 0.65);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 28px;
        padding: 48px 40px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7);
      }

      .brand-header {
        text-align: center;
        margin-bottom: 40px;
      }

      .logo-icon {
        font-size: 3rem;
        margin-bottom: 12px;
        display: block;
      }

      .logo-title {
        font-size: 1.875rem;
        font-weight: 800;
        letter-spacing: -0.025em;
        background: linear-gradient(to bottom, #ffffff, #94a3b8);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }

      .logo-subtitle {
        color: var(--slate-400);
        font-size: 0.9375rem;
        margin-top: 4px;
      }

      .form-content {
        display: flex;
        flex-direction: column;
        gap: 24px;
      }

      .form-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
      }

      .form-group label {
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--slate-200);
        margin-left: 4px;
      }

      .form-group input {
        background: rgba(2, 6, 23, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        padding: 14px 16px;
        color: var(--white);
        font-size: 1rem;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      }

      .form-group input:focus {
        outline: none;
        border-color: var(--primary-light);
        box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.15);
        background: rgba(2, 6, 23, 0.6);
      }

      .form-group input::placeholder {
        color: var(--slate-500);
      }

      .submit-button {
        margin-top: 8px;
        background: linear-gradient(
          135deg,
          var(--primary) 0%,
          var(--primary-dark) 100%
        );
        color: white;
        border: none;
        border-radius: 14px;
        padding: 16px;
        font-size: 1rem;
        font-weight: 700;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        transition: all 0.3s ease;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
      }

      .submit-button:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 12px 20px rgba(37, 99, 235, 0.4);
        filter: brightness(1.1);
      }

      .submit-button:active {
        transform: translateY(1px);
      }

      .submit-button:disabled {
        opacity: 0.7;
        cursor: not-allowed;
      }

      .alert-box {
        color: var(--error);
        font-size: 0.875rem;
        text-align: center;
        margin-top: 20px;
        padding: 12px;
        background: rgba(239, 68, 68, 0.08);
        border: 1px solid rgba(239, 68, 68, 0.2);
        border-radius: 12px;
        display: none;
      }

      .login-footer {
        margin-top: 32px;
        text-align: center;
        color: var(--slate-500);
        font-size: 0.8125rem;
      }

      @media (max-width: 480px) {
        .login-card {
          padding: 40px 24px;
        }
        .logo-title {
          font-size: 1.625rem;
        }
      }
    </style>

    <script>
      import { signInUser } from "../lib/auth";

      const form = document.getElementById("login-form") as HTMLFormElement;
      const emailInput = document.getElementById("usuario") as HTMLInputElement;
      const passInput = document.getElementById("password") as HTMLInputElement;
      const errorBox = document.getElementById("error-box");
      const submitBtn = document.getElementById(
        "submit-btn",
      ) as HTMLButtonElement;

      form?.addEventListener("submit", async (e) => {
        e.preventDefault();

        if (errorBox) {
          errorBox.style.display = "none";
          errorBox.textContent = "";
        }

        if (submitBtn) {
          submitBtn.disabled = true;
          const originalContent = submitBtn.innerHTML;
          submitBtn.innerHTML = "<span>Verificando...</span>";

          try {
            await signInUser(emailInput.value, passInput.value);
            window.location.href = "/init";
          } catch (error: any) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalContent;

            if (errorBox) {
              errorBox.textContent =
                error.message || "Credenciales incorrectas";
              errorBox.style.display = "block";
            }
          }
        }
      });
    </script>
  </body>
</html>
