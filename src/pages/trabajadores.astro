---
import Navbar from "../components/navbar.astro";
---

<!DOCTYPE html>
<html lang="es-co">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Trabajadores | Gestión de Personal Premium</title>
    
    <!-- Premium Font: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <style>
      body { font-family: 'Inter', system-ui, -apple-system, sans-serif; background-color: #f8fafc; margin: 0; color: #0f172a; }
      .container { padding: 40px 24px; max-width: 1000px; margin: 0 auto; }
      
      .header-flex { display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px; }
      h1 { margin: 0; font-size: 2rem; font-weight: 800; color: #0f172a; letter-spacing: -0.04em; }
      
      .btn-toggle { 
        padding: 12px 28px; background: linear-gradient(135deg, #a78bfa 0%, #7c3aed 100%); 
        color: white; border: none; border-radius: 14px; cursor: pointer; font-weight: 800; 
        transition: all 0.3s; box-shadow: 0 4px 12px rgba(167, 139, 250, 0.3);
      }
      .btn-toggle:hover { transform: translateY(-2px); box-shadow: 0 12px 20px rgba(167, 139, 250, 0.4); }
      
      .form-card { background: white; padding: 32px; border-radius: 28px; border: 1px solid #e2e8f0; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.05); margin-bottom: 40px; }
      .form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; }
      .form-group { display: flex; flex-direction: column; gap: 8px; }
      label { font-size: 0.75rem; font-weight: 800; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em; }
      input, select { padding: 14px; border: 1px solid #e2e8f0; border-radius: 12px; font-size: 1rem; background: #f8fafc; transition: all 0.2s; }
      input:focus { outline: none; border-color: #a78bfa; box-shadow: 0 0 0 4px rgba(167, 139, 250, 0.1); background: white; }
      .btn-submit { width: 100%; padding: 16px; background: linear-gradient(135deg, #a78bfa 0%, #7c3aed 100%); color: white; border: none; border-radius: 14px; cursor: pointer; font-weight: 800; margin-top: 24px; box-shadow: 0 4px 12px rgba(167, 139, 250, 0.3); }

      /* LISTA DE TRABAJADORES (REQUISITOS DEL USUARIO) */
      #lista-trabajadores { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 28px; }
      
      .worker-card { 
        background: white; padding: 32px; border-radius: 28px; border: 1px solid #f1f5f9; 
        display: flex; justify-content: space-between; align-items: center; gap: 24px;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05), 0 4px 6px -2px rgba(0, 0, 0, 0.02); 
        position: relative; overflow: hidden; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      }
      .worker-card:hover { transform: translateY(-6px); box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1); border-color: #a78bfa; }
      .worker-card::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 8px; background: #a78bfa; }

      .card-info { flex: 1; display: flex; flex-direction: column; gap: 6px; }
      .worker-name { font-size: 1.25rem; font-weight: 800; color: #0f172a; letter-spacing: -0.02em; }
      .worker-id { font-family: monospace; font-size: 0.85rem; color: #64748b; background: #f1f5f9; padding: 2px 8px; border-radius: 6px; width: fit-content; }
      .worker-meta { display: flex; gap: 16px; font-size: 0.9rem; color: #64748b; font-weight: 500; }
      .salary-tag { color: #059669; font-weight: 800; font-size: 1.15rem; }

      .card-actions { display: flex; gap: 12px; align-items: center; }
      .btn-edit { padding: 10px 20px; background: #f5f3ff; color: #7c3aed; border: none; border-radius: 12px; cursor: pointer; font-weight: 800; font-size: 0.9rem; transition: all 0.2s; }
      .btn-edit:hover { background: #ede9fe; transform: scale(1.05); }
      .btn-delete { padding: 10px 20px; background: #fef2f2; color: #ef4444; border: none; border-radius: 12px; cursor: pointer; font-weight: 800; font-size: 0.9rem; transition: all 0.2s; }
      .btn-delete:hover { background: #fee2e2; transform: scale(1.05); }

      #msg { text-align: center; font-weight: 700; margin-top: 10px; }

      .filter-section {
        background: white;
        padding: 20px;
        border-radius: 20px;
        border: 1px solid #e2e8f0;
        margin-bottom: 32px;
        display: flex;
        gap: 16px;
        align-items: flex-end;
        flex-wrap: wrap;
      }
      .btn-search {
        padding: 12px 24px;
        background: #475569;
        color: white;
        border: none;
        border-radius: 12px;
        cursor: pointer;
        font-weight: 700;
        transition: all 0.2s;
      }
      .btn-search:hover { background: #1e293b; }
      .context-hint {
        font-size: 0.95rem;
        color: #64748b;
        margin: -16px 0 24px 0;
        font-weight: 600;
      }
      .context-hint strong { color: #0f172a; }

      .page-hero {
        background: linear-gradient(135deg, #f5f3ff 0%, #faf5ff 45%, #f8fafc 100%);
        border: 1px solid #e9d5ff;
        border-radius: 24px;
        padding: 28px 32px;
        margin-bottom: 28px;
        position: relative;
        overflow: hidden;
      }
      .page-hero::after {
        content: "";
        position: absolute;
        top: 0;
        right: 0;
        width: 200px;
        height: 100%;
        background: radial-gradient(ellipse at top right, rgba(124, 58, 237, 0.1), transparent 70%);
        pointer-events: none;
      }
      .page-hero__badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 0.7rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: #6d28d9;
        background: rgba(255, 255, 255, 0.95);
        border: 1px solid #ddd6fe;
        padding: 6px 12px;
        border-radius: 999px;
        margin-bottom: 12px;
      }
      .page-hero__badge::before {
        content: "";
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #7c3aed;
        box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.25);
      }
      .page-hero__title {
        margin: 0 0 8px 0;
        font-size: 1.75rem;
        font-weight: 800;
        color: #0f172a;
        letter-spacing: -0.03em;
      }
      .page-hero__desc {
        margin: 0;
        font-size: 0.95rem;
        color: #64748b;
        line-height: 1.55;
        max-width: 54ch;
      }
    </style>
  </head>
  <body>
    <Navbar />
    <div class="container">
      <header class="page-hero">
        <span class="page-hero__badge">Base de datos · Personal</span>
        <h2 class="page-hero__title">Trabajadores por sede</h2>
        <p class="page-hero__desc">
          Listado y altas de <strong>personas y salarios</strong> por negocio. Para tendencias y gráficos de nómina usa <strong>Análisis → Reportes nómina</strong>.
        </p>
      </header>

      <div class="header-flex">
        <h1>Gestión de Trabajadores</h1>
        <button id="btn-toggle-form" class="btn-toggle">+ Registrar Personal</button>
      </div>

      <p id="context-trab" class="context-hint" style="display: none;"></p>

      <div class="filter-section">
        <div class="form-group" style="flex: 1; min-width: 200px;">
          <label>Ver base de datos de la sede</label>
          <select id="filter-negocio"></select>
        </div>
        <button id="btn-search" type="button" class="btn-search">Actualizar</button>
      </div>

      <div id="form-container" class="form-card" style="display: none;">
        <form id="form-trabajador">
          <div class="form-grid">
            <div class="form-group">
                <label>Nombre Completo</label>
                <input type="text" id="t-nombre" placeholder="Nombre..." required />
            </div>
            <div class="form-group">
                <label>Identificación (ID)</label>
                <input type="text" id="t-id" placeholder="Cédula / ID" required />
            </div>
            <div class="form-group">
                <label>Cargo / Rol</label>
                <input type="text" id="t-cargo" placeholder="Ej: Administrador" required />
            </div>
            <div class="form-group">
                <label>Salario Base ($)</label>
                <input type="number" id="t-salario" placeholder="0" required />
            </div>
            <div class="form-group">
                <label>Sede Asociada</label>
                <select id="t-sede" required></select>
            </div>
          </div>
          <button type="submit" class="btn-submit">Guardar en Base de Datos</button>
        </form>
        <p id="msg"></p>
      </div>

      <ul id="lista-trabajadores">
        <li style="text-align: center; color: #94a3b8; padding: 60px;">Cargando personal...</li>
      </ul>
    </div>

    <script>
      import { getSession } from "../lib/auth";
      import { getTrabajadoresFiltrados, addTrabajador, deleteTrabajador } from "../lib/workers";
      import { getNegocios } from "../lib/negocios";

      function sedeDe(t: any): string {
        return String(t?.negocio ?? t?.sede ?? "").trim();
      }

      async function init() {
        const session = await getSession();
        if (!session) { window.location.replace("/"); return; }
        await loadNegocios();
        loadData();
      }

      async function loadNegocios() {
        const negs = await getNegocios();
        const opts = negs.map(n => `<option value="${n.nombre}">${n.nombre}</option>`).join("");
        (document.getElementById("t-sede") as HTMLSelectElement).innerHTML = opts;
        (document.getElementById("filter-negocio") as HTMLSelectElement).innerHTML = opts;
      }

      async function loadData() {
        const lista = document.getElementById("lista-trabajadores")!;
        const fNeg = (document.getElementById("filter-negocio") as HTMLSelectElement).value;
        const hint = document.getElementById("context-trab")!;

        if (!fNeg) {
          hint.style.display = "none";
          lista.innerHTML = `<li style="text-align: center; padding: 60px; color: #94a3b8;">Configura al menos un negocio en la tabla <code>negocios</code> para filtrar personal por sede.</li>`;
          return;
        }

        hint.innerHTML = `Mostrando personal de: <strong>${fNeg}</strong>`;
        hint.style.display = "block";

        try {
          (document.getElementById("t-sede") as HTMLSelectElement).value = fNeg;

          let data = await getTrabajadoresFiltrados(fNeg);
          data = (data || []).filter((t: any) => sedeDe(t) === fNeg);

          lista.innerHTML = data.length ? "" : `<li style="text-align: center; padding: 60px; color: #94a3b8;">No hay personal en esta sede.</li>`;
          
          data.forEach(item => {
            const li = document.createElement("li");
            li.className = "worker-card";
            const doc = item.identificacion ?? item.documento ?? "";
            const sedeLabel = sedeDe(item) || "—";
            li.innerHTML = `
              <div class="card-info">
                <span class="worker-name">${item.nombre}</span>
                <span class="worker-id">ID: ${doc}</span>
                <div class="worker-meta">
                  <span>${item.cargo || "—"}</span> • <span>${sedeLabel}</span>
                </div>
                <span class="salary-tag">$${Number(item.salario_base || 0).toLocaleString()}</span>
              </div>
              <div class="card-actions">
                <button class="btn-edit" onclick="alert('Función de edición en desarrollo')">Editar</button>
                <button class="btn-delete" data-id="${item.id}" data-nombre="${item.nombre}">Eliminar</button>
              </div>
            `;
            lista.appendChild(li);
          });

          document.querySelectorAll('.btn-delete').forEach(btn => {
            btn.addEventListener('click', async (e: any) => {
              if (confirm(`¿Eliminar a "${e.target.dataset.nombre}"?`)) {
                await deleteTrabajador(e.target.dataset.id);
                loadData();
              }
            });
          });
        } catch (e) { console.error(e); }
      }

      document.getElementById("btn-search")?.addEventListener("click", loadData);

      const toggleBtn = document.getElementById("btn-toggle-form")!;
      const cont = document.getElementById("form-container")!;
      toggleBtn.addEventListener("click", () => {
        const isHidden = cont.style.display === "none";
        cont.style.display = isHidden ? "block" : "none";
        toggleBtn.textContent = isHidden ? "- Ocultar Formulario" : "+ Registrar Personal";
        toggleBtn.style.background = isHidden ? "#ef4444" : "linear-gradient(135deg, #a78bfa 0%, #7c3aed 100%)";
      });

      document.getElementById("form-trabajador")?.addEventListener("submit", async (e: any) => {
        e.preventDefault();
        const msg = document.getElementById("msg")!;
        try {
          msg.textContent = "Guardando...";
          await addTrabajador({
            nombre: (document.getElementById("t-nombre") as HTMLInputElement).value,
            documento: (document.getElementById("t-id") as HTMLInputElement).value,
            cargo: (document.getElementById("t-cargo") as HTMLInputElement).value,
            salario_base: parseFloat((document.getElementById("t-salario") as HTMLInputElement).value),
            negocio: (document.getElementById("t-sede") as HTMLSelectElement).value
          });
          msg.textContent = "✓ Guardado con éxito";
          msg.style.color = "#10b981";
          e.target.reset();
          loadData();
          setTimeout(() => { msg.textContent = ""; toggleBtn.click(); }, 1500);
        } catch (err: any) {
          msg.textContent = "Error: " + err.message;
          msg.style.color = "#ef4444";
        }
      });

      init();
    </script>
  </body>
</html>
