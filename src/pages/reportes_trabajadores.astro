---
import Navbar from "../components/navbar.astro";
---

<!DOCTYPE html>
<html lang="es-co">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reportes de Nómina</title>
    
    <!-- Premium Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
      body { font-family: 'Inter', system-ui, -apple-system, sans-serif; background-color: #f3f4f6; margin: 0; color: #1f2937; }
      .container { max-width: 1100px; margin: 0 auto; padding: 24px; }
      
      h1 { font-size: 2rem; font-weight: 800; color: #111827; margin-bottom: 24px; letter-spacing: -0.02em; }
      
      .main-card { background: white; padding: 24px; border-radius: 20px; border: 1px solid #e5e7eb; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); margin-bottom: 32px; }
      .filters { display: flex; gap: 16px; flex-wrap: wrap; align-items: flex-end; }
      label { display: flex; flex-direction: column; gap: 8px; font-weight: 800; color: #6b7280; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; }
      input, select { padding: 12px; border: 1px solid #d1d5db; border-radius: 12px; font-size: 0.95rem; background: #f9fafb; transition: all 0.2s; }
      input:focus, select:focus { outline: none; border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1); background: white; }
      
      .btn { padding: 12px 24px; background-color: #3b82f6; color: white; border: none; border-radius: 12px; cursor: pointer; font-weight: 800; font-size: 0.95rem; transition: all 0.2s; }
      .btn:hover:not(:disabled) { background-color: #2563eb; transform: translateY(-1px); box-shadow: 0 10px 15px -3px rgba(59, 130, 246, 0.25); }
      .btn:disabled { background-color: #94a3b8; cursor: not-allowed; }

      .charts-grid { display: grid; grid-template-columns: 1fr; gap: 24px; margin-bottom: 32px; }
      @media (min-width: 900px) { .charts-grid { grid-template-columns: 1fr 1fr; } }
      
      .chart-card { background: white; padding: 24px; border-radius: 20px; border: 1px solid #e5e7eb; height: 400px; }
      .chart-card h3 { font-size: 1rem; font-weight: 800; margin-top: 0; margin-bottom: 16px; color: #374151; }
      .chart-wrap { height: 320px; position: relative; }

      .table-card { background: white; padding: 24px; border-radius: 20px; border: 1px solid #e5e7eb; overflow: hidden; }
      .table-card h3 { font-size: 1.1rem; font-weight: 800; margin-top: 0; margin-bottom: 16px; }
      
      table { width: 100%; border-collapse: collapse; }
      th, td { padding: 16px; border-bottom: 1px solid #f1f5f9; text-align: left; }
      th { color: #64748b; font-weight: 800; font-size: 0.7rem; text-transform: uppercase; background: #f8fafc; }
      td { font-size: 0.95rem; }
      .msg { color: #94a3b8; margin-top: 12px; font-weight: 500; text-align: center; padding: 20px; font-style: italic; }
      
      .payroll-val { color: #059669; font-weight: 800; }
      .badge-mes { font-family: monospace; background: #e2e8f0; padding: 4px 8px; border-radius: 6px; font-weight: 600; color: #475569; }
    </style>
  </head>
  <body>
    <Navbar />

    <div class="container">
      <h1>Análisis de Nómina Mensual</h1>

      <div class="main-card">
        <div class="filters">
          <label style="min-width: 260px;">
            Negocio / Sede
            <select id="rep-trab-negocio">
              <option value="">Cargando sedes...</option>
            </select>
          </label>

          <label style="min-width: 200px;">
            Desde el mes
            <input id="rep-trab-mes-desde" type="month" />
          </label>

          <label style="min-width: 200px;">
            Hasta el mes
            <input id="rep-trab-mes-hasta" type="month" />
          </label>

          <button id="btn-trab-aplicar" class="btn">Actualizar Vista</button>
        </div>

        <div id="rep-trab-msg" class="msg" style="display:none;"></div>
      </div>

      <div class="charts-grid">
        <div class="chart-card">
          <h3>Inversión en Salarios por Mes</h3>
          <div class="chart-wrap">
            <canvas id="chart-trab-salario"></canvas>
          </div>
        </div>

        <div class="chart-card">
          <h3>Evolución de Fuerza Laboral</h3>
          <div class="chart-wrap">
            <canvas id="chart-trab-cantidad"></canvas>
          </div>
        </div>
      </div>

      <div class="table-card">
        <h3>Resumen Detallado por Periodo</h3>
        <div id="tabla-trab-mensual" style="overflow-x: auto;"></div>
      </div>
    </div>

    <script>
      import { getSession, getUserRole } from "../lib/auth";
      import { getTrabajadores } from "../lib/workers";

      let trabajadores: any[] = [];
      let chartSalario: any = null;
      let chartCantidad: any = null;

      const msgEl = document.getElementById("rep-trab-msg");
      const negocioSelect = document.getElementById("rep-trab-negocio") as HTMLSelectElement;
      const mesDesdeInput = document.getElementById("rep-trab-mes-desde") as HTMLInputElement;
      const mesHastaInput = document.getElementById("rep-trab-mes-hasta") as HTMLInputElement;
      const btnAplicar = document.getElementById("btn-trab-aplicar");
      const tablaEl = document.getElementById("tabla-trab-mensual");

      const normalizeMes = (value: any) => {
        const str = String(value ?? "").trim();
        if (!str) return "";
        if (/^\d{4}-\d{2}$/.test(str)) return str;
        return str.slice(0, 7);
      };

      const normalizeNegocio = (row: any) => (row?.negocio || "General").trim();

      async function checkAccess() {
        const session = await getSession();
        if (!session) { window.location.replace("/"); return false; }
        const role = await getUserRole(session.user.id);
        if (role !== "admin") { window.location.replace("/init"); return false; }
        return true;
      }

      async function load() {
        trabajadores = await getTrabajadores();
        if (!trabajadores || trabajadores.length === 0) {
          msgEl!.textContent = "No hay registros de trabajadores todavía.";
          msgEl!.style.display = "block";
          return;
        }

        const negocios = Array.from(new Set(trabajadores.map(normalizeNegocio))).sort();
        negocioSelect.innerHTML = negocios.map(n => `<option value="${n}">${n}</option>`).join("");

        const meses = trabajadores.map(r => normalizeMes(r.mes || r.created_at)).filter(m => m).sort();
        if (meses.length > 0) {
          mesDesdeInput.value = meses[0];
          mesHastaInput.value = meses[meses.length - 1];
        }
        await aplicar();
      }

      async function aplicar() {
        if (!trabajadores.length) return;
        if (chartSalario) chartSalario.destroy();
        if (chartCantidad) chartCantidad.destroy();

        const negocio = negocioSelect.value;
        const mesDesde = mesDesdeInput.value;
        const mesHasta = mesHastaInput.value;
        const grupos: Record<string, { cantidad: number; salarioTotal: number }> = {};

        trabajadores.forEach(row => {
          if (normalizeNegocio(row) !== negocio) return;
          const mesKey = normalizeMes(row.mes || row.created_at);
          if (!mesKey || mesKey < mesDesde || mesKey > mesHasta) return;

          if (!grupos[mesKey]) grupos[mesKey] = { cantidad: 0, salarioTotal: 0 };
          grupos[mesKey].cantidad += 1;
          grupos[mesKey].salarioTotal += Number(row.salario_base || 0);
        });

        const mesesOrdenados = Object.keys(grupos).sort();
        if (!mesesOrdenados.length) {
          tablaEl!.innerHTML = `<p class="msg">No hay datos para esta selección.</p>`;
          return;
        }

        tablaEl!.innerHTML = `
          <table>
            <thead>
              <tr>
                <th>Periodo (Mes)</th>
                <th>Personal Activo</th>
                <th>Costo Total Nómina</th>
              </tr>
            </thead>
            <tbody>
              ${mesesOrdenados.map(m => `
                <tr>
                  <td><span class="badge-mes">${m}</span></td>
                  <td><strong>${grupos[m].cantidad}</strong> colaboradores</td>
                  <td class="payroll-val">$${grupos[m].salarioTotal.toLocaleString('es-CO')}</td>
                </tr>
              `).join('')}
            </tbody>
          </table>
        `;

        const ChartRef = (window as any).Chart;
        const opts = { responsive: true, maintainAspectRatio: false };

        chartSalario = new ChartRef(document.getElementById("chart-trab-salario"), {
          type: "line",
          data: {
            labels: mesesOrdenados,
            datasets: [{ label: "Nómina ($)", data: mesesOrdenados.map(m => grupos[m].salarioTotal), borderColor: "#f59e0b", backgroundColor: "rgba(245, 158, 11, 0.1)", fill: true, tension: 0.3 }]
          },
          options: opts
        });

        chartCantidad = new ChartRef(document.getElementById("chart-trab-cantidad"), {
          type: "bar",
          data: {
            labels: mesesOrdenados,
            datasets: [{ label: "Empleados", data: mesesOrdenados.map(m => grupos[m].cantidad), backgroundColor: "#10b981", borderRadius: 8 }]
          },
          options: opts
        });
      }

      btnAplicar?.addEventListener("click", aplicar);
      checkAccess().then(ok => { if (ok) load(); });
    </script>
  </body>
</html>
