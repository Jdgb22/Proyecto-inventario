---
import Navbar from "../components/navbar.astro";
---

<!DOCTYPE html>
<html lang="es-co">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Carga Masiva de Inventario</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- SheetJS (XLSX) vía CDN -->
    <script src="https://cdn.sheetjs.com/xlsx-latest/package/dist/xlsx.full.min.js"></script>

    <style>
      body { font-family: 'Inter', system-ui, -apple-system, sans-serif; background-color: #f3f4f6; margin: 0; color: #1f2937; }
      .container { padding: 24px; max-width: 1000px; margin: 0 auto; }
      
      .header-flex { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 16px; }
      .header-flex h1 { margin: 0; font-size: 1.8rem; font-weight: 800; color: #111827; letter-spacing: -0.025em; }
      
      .main-card { background: white; padding: 32px; border-radius: 16px; border: 1px solid #e5e7eb; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); margin-bottom: 32px; }
      
      .form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 24px; }
      .form-group { display: flex; flex-direction: column; gap: 8px; }
      label { font-size: 0.75rem; font-weight: 700; color: #6b7280; text-transform: uppercase; letter-spacing: 0.05em; }
      input, select { padding: 12px; border: 1px solid #d1d5db; border-radius: 10px; font-size: 1rem; background: #f9fafb; transition: all 0.2s; }
      input:focus, select:focus { outline: none; border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1); background: white; }
      
      .info-banner { background-color: #eff6ff; border: 1px solid #dbeafe; color: #1e40af; padding: 16px; border-radius: 12px; margin-bottom: 24px; font-size: 0.9rem; line-height: 1.6; display: flex; align-items: flex-start; gap: 12px; }

      .upload-zone { border: 2px dashed #cbd5e1; padding: 60px 40px; text-align: center; border-radius: 16px; background: #f8fafc; cursor: pointer; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); margin-bottom: 32px; }
      .upload-zone:hover { border-color: #3b82f6; background-color: #eff6ff; transform: translateY(-2px); }
      .upload-icon { width: 64px; height: 64px; color: #94a3b8; margin: 0 auto 16px; }
      #file-input { display: none; }

      .btn { padding: 14px 28px; background: #3b82f6; color: white; border: none; border-radius: 12px; cursor: pointer; font-weight: 700; font-size: 1rem; transition: all 0.2s; display: inline-flex; align-items: center; justify-content: center; gap: 8px; }
      .btn:hover:not(:disabled) { background: #2563eb; transform: translateY(-1px); box-shadow: 0 10px 15px -3px rgba(59, 130, 246, 0.3); }
      .btn:disabled { background: #94a3b8; cursor: not-allowed; opacity: 0.7; }
      .btn-success { background: #10b981; }
      .btn-success:hover { background: #059669; box-shadow: 0 10px 15px -3px rgba(16, 185, 129, 0.3); }
      .btn-gray { background: #64748b; }
      .btn-gray:hover:not(:disabled) { background: #475569; }

      .preview-container { display: none; margin-top: 32px; animation: fadeIn 0.4s ease-out; }
      @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

      .preview-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1px solid #e5e7eb; }
      .preview-card-list { display: flex; flex-direction: column; gap: 12px; max-height: 500px; overflow-y: auto; padding-right: 8px; }
      .preview-card { background: #f8fafc; padding: 16px; border-radius: 12px; border: 1px solid #e2e8f0; display: grid; grid-template-columns: 1fr 2fr 1fr 1fr 1fr; align-items: center; gap: 16px; font-size: 0.9rem; }
      
      .sku-tag { font-family: monospace; font-weight: 700; color: #475569; background: #e2e8f0; padding: 2px 6px; border-radius: 4px; }
      .name-tag { font-weight: 600; color: #1e293b; }
      .price-tag { color: #059669; font-weight: 700; }
      .qty-tag { font-weight: 800; color: #1e293b; }
      .status-tag { font-size: 0.7rem; font-weight: 800; text-transform: uppercase; padding: 4px 10px; border-radius: 9999px; text-align: center; }
      .status-new { background: #d1fae5; color: #065f46; }
      .status-update { background: #fef3c7; color: #92400e; }

      .actions-bar { margin-top: 24px; display: flex; justify-content: space-between; align-items: center; padding-top: 24px; border-top: 2px solid #f1f5f9; }
      #loading-msg { text-align: center; color: #64748b; font-weight: 600; margin-top: 20px; display: none; }
    </style>
  </head>
  <body>
    <Navbar />
    
    <div class="container">
      <div class="header-flex">
        <h1>Cargar Inventario Masivo</h1>
        <a href="/plantilla_inventario.xlsx" download="plantilla_inventario.xlsx" class="btn btn-gray" style="text-decoration: none;">
          <svg style="width:20px; height:20px;" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
          Descargar Plantilla
        </a>
      </div>
      
      <div class="main-card">
        <div class="form-grid">
            <div class="form-group">
                <label>Sede Destino</label>
                <select id="inv-negocio" required></select>
            </div>
            <div class="form-group">
                <label>Mes de Registro</label>
                <input id="inv-mes" type="month" required />
            </div>
        </div>

        <div class="info-banner">
          <span style="font-size: 1.5rem;">💡</span>
          <div>
            <strong>Sincronización Inteligente Activada:</strong> El sistema actualizará automáticamente la <strong>Base de Datos</strong> general y sumará las existencias al mes actual. Asegúrate de que las columnas tengan los nombres correctos: <i>Código, Nombre, Cantidad, Precio</i>.
          </div>
        </div>

        <div class="upload-zone" id="drop-zone" onclick="document.getElementById('file-input').click()">
            <svg class="upload-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path></svg>
            <p style="font-size: 1.1rem; color: #1e293b; margin:0;"><strong>Haz clic o arrastra tu archivo Excel</strong></p>
            <p style="font-size: 0.85rem; color: #64748b; margin-top: 8px;">Formatos aceptados: .xlsx, .xls, .csv</p>
            <input type="file" id="file-input" accept=".xlsx, .xls, .csv" />
        </div>

        <p id="loading-msg">Procesando archivo... un momento por favor.</p>

        <div class="preview-container" id="preview-container">
            <div class="preview-header">
                <h3 style="margin:0; font-size: 1.1rem; color: #475569;">Vista Previa de Carga</h3>
            </div>
            
            <div class="preview-card-list" id="preview-list"></div>

            <div class="actions-bar">
                <p id="result-msg" style="font-weight: 700; margin: 0;"></p>
                <button id="btn-confirm" class="btn btn-success">Sincronizar Todo al Inventario</button>
            </div>
        </div>
      </div>
    </div>

    <script>
      import { getStockFiltrado, getMasterProductos, addStockEntry } from "../lib/inventory";
      import { getNegocios } from "../lib/negocios";

      let stockActualEnDB: any[] = [];
      let dbMaestra: any[] = [];
      let itemsParaSync: any[] = [];
      let negocioActual = "";
      let mesActual = "";

      async function init() {
        const negSelect = document.getElementById("inv-negocio") as HTMLSelectElement;
        const mesInput = document.getElementById("inv-mes") as HTMLInputElement;
        const now = new Date();
        mesInput.value = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;

        try {
          const negocios = await getNegocios();
          if (negSelect) {
            negSelect.innerHTML = negocios.map(n => `<option value="${n.nombre}">${n.nombre}</option>`).join("");
          }
        } catch (e) {
          // console.warn(e);
        }
      }
      init();

      const fileInput = document.getElementById("file-input") as HTMLInputElement;
      const dropZone = document.getElementById("drop-zone");
      const loadingMsg = document.getElementById("loading-msg");
      const previewContainer = document.getElementById("preview-container");
      const previewList = document.getElementById("preview-list");
      const btnConfirm = document.getElementById("btn-confirm") as HTMLButtonElement;
      const resultMsg = document.getElementById("result-msg");
      const filterNeg = document.getElementById("inv-negocio") as HTMLSelectElement;
      const filterMes = document.getElementById("inv-mes") as HTMLInputElement;

      dropZone?.addEventListener("dragover", (e) => { e.preventDefault(); dropZone.style.borderColor = "#3b82f6"; });
      dropZone?.addEventListener("dragleave", () => { dropZone.style.borderColor = "#cbd5e1"; });
      dropZone?.addEventListener("drop", (e) => {
        e.preventDefault();
        dropZone.style.borderColor = "#cbd5e1";
        if (e.dataTransfer?.files.length) processFile(e.dataTransfer.files[0]);
      });

      fileInput?.addEventListener("change", (e: any) => { if (e.target.files?.length) processFile(e.target.files[0]); });

      async function processFile(file: File) {
        negocioActual = filterNeg.value;
        mesActual = filterMes.value;

        if (!negocioActual || !mesActual) {
          alert("Selecciona primero la Sede y el Mes."); return;
        }

        loadingMsg!.style.display = "block";
        previewContainer!.style.display = "none";
        
        try {
          stockActualEnDB = await getStockFiltrado(negocioActual, mesActual);
          dbMaestra = await getMasterProductos();

          const reader = new FileReader();
          reader.onload = (e: any) => {
            try {
              const XLSX_LIB = (window as any).XLSX;
              if (!XLSX_LIB) throw new Error("Motor de Excel aún cargando. Intenta otra vez.");

              const arr = new Uint8Array(e.target.result);
              const wb = XLSX_LIB.read(arr, { type: 'array' });
              const sheet = wb.Sheets[wb.SheetNames[0]];
              const rawJson = XLSX_LIB.utils.sheet_to_json(sheet);
              displayPreview(rawJson);
            } catch (err: any) {
              // console.warn(err);
              alert("Error procesando Excel: " + (err.message || "Archivo corrupto o vacío."));
              loadingMsg!.style.display = "none";
            }
          };
          reader.readAsArrayBuffer(file);
        } catch (error) {
          // console.warn(error);
          alert("Error en validación.");
          loadingMsg!.style.display = "none";
        }
      }

      function displayPreview(data: any[]) {
        previewList!.innerHTML = "";
        let grandTotal = 0;
        let errores = 0;

        itemsParaSync = data.map(row => {
          const rowNombre = String(row.Producto || row.producto || row.Nombre || row.nombre || "").trim().toLowerCase();
          const rowCodigo = String(row.Codigo || row.codigo || row.SKU || "").trim();
          const cantidad = parseInt(row.Cantidad || row.cantidad || 0);

          const masterMatch = dbMaestra.find(m => {
            const mCod = String(m.codigo).trim();
            const mNom = String(m.nombre).trim().toLowerCase();
            return (rowCodigo && mCod === rowCodigo) || (rowNombre && mNom === rowNombre);
          });
          
          const codigoOficial = masterMatch ? String(masterMatch.codigo).trim() : rowCodigo;
          const stockMatch = stockActualEnDB.find(i => String(i.codigo).trim() === codigoOficial);

          if (!masterMatch) {
             errores++;
             return { isValid: false, codigo: codigoOficial || "SIN CÓDIGO", cantidad, errorReason: "NO ENCONTRADO EN DB" };
          }

          const dbPrecio = masterMatch.precio || 0;
          const subtotalRow = dbPrecio * cantidad;
          grandTotal += subtotalRow;
          
          return {
            isValid: true,
            nombre: masterMatch.nombre, 
            categoria: masterMatch.categoria,
            codigo: codigoOficial, 
            cantidad, 
            precio: dbPrecio, 
            subtotalRow,
            existingId: stockMatch?.id || null,
            sumResult: (stockMatch ? stockMatch.cantidad : 0) + cantidad
          };
        });

        itemsParaSync.forEach(item => {
          const div = document.createElement("div");
          div.className = "preview-card";
          
          if (!item.isValid) {
            div.style.backgroundColor = "#fef2f2";
            div.style.borderColor = "#fca5a5";
            div.innerHTML = `
              <div><span class="sku-tag" style="background:#fee2e2; color:#991b1b;">${item.codigo}</span></div>
              <div class="name-tag" style="color:#b91c1c;">${item.errorReason}</div>
              <div class="price-tag">-</div>
              <div><span class="qty-tag">${item.cantidad} uns.</span></div>
              <div><span class="status-tag" style="background:#fee2e2; color:#b91c1c;">Omitido</span></div>
            `;
          } else {
            div.innerHTML = `
              <div><span class="sku-tag">${item.codigo}</span></div>
              <div class="name-tag">${item.nombre}</div>
              <div class="price-tag">$${item.subtotalRow.toLocaleString('es-CO')} <br/><small style="color:#94a3b8; font-weight:500;">$${item.precio.toLocaleString()} c/u</small></div>
              <div><span class="qty-tag">+ ${item.cantidad}</span> <br/> <small style="color:#94a3b8;">Total mes: ${item.sumResult}</small></div>
              <div><span class="status-tag ${item.existingId ? 'status-update' : 'status-new'}">${item.existingId ? 'Sumar' : 'Nuevo'}</span></div>
            `;
          }
          previewList!.appendChild(div);
        });

        const totalBanner = document.createElement("div");
        totalBanner.style.background = "linear-gradient(135deg, #10b981 0%, #059669 100%)";
        totalBanner.style.color = "white";
        totalBanner.style.padding = "20px 24px";
        totalBanner.style.borderRadius = "16px";
        totalBanner.style.marginTop = "24px";
        totalBanner.style.display = "flex";
        totalBanner.style.justifyContent = "space-between";
        totalBanner.style.alignItems = "center";
        totalBanner.innerHTML = `
           <div>
             <h3 style="margin:0; font-size:1.15rem; font-weight:800;">Valorización del Archivo</h3>
             <p style="margin:4px 0 0 0; opacity:0.9; font-size:0.9rem;">${itemsParaSync.filter(i => i.isValid).length} productos validados ${errores > 0 ? '<strong style="color:#fee2e2;">(' + errores + ' errores omitidos)</strong>' : ""}</p>
           </div>
           <div style="font-size:1.8rem; font-weight:800; letter-spacing:-0.03em;">$${grandTotal.toLocaleString('es-CO')}</div>
        `;
        previewList!.appendChild(totalBanner);

        loadingMsg!.style.display = "none";
        previewContainer!.style.display = "block";
      }

      btnConfirm.addEventListener("click", async () => {
        btnConfirm.disabled = true;
        resultMsg!.textContent = "Sincronizando inventario...";
        resultMsg!.style.color = "#4b5563";
        
        let count = 0;
        let dbErrores = 0;
        let dbErrorMsg = "";
        const validItems = itemsParaSync.filter(i => i.isValid);

        if (validItems.length === 0) {
           resultMsg!.textContent = "No hay ningún registro válido (verde) para sincronizar. Todos están omitidos.";
           resultMsg!.style.color = "#ef4444";
           btnConfirm.disabled = false;
           return;
        }

        const CHUNK_SIZE = 15;

        for (let i = 0; i < validItems.length; i += CHUNK_SIZE) {
          const chunk = validItems.slice(i, i + CHUNK_SIZE);
          await Promise.all(chunk.map(async (item) => {
            try {
              // Sincronizar Inventario Mensual (Validado)
              await addStockEntry({
                codigo: item.codigo,
                cantidad: item.sumResult,
                negocio: negocioActual,
                mes: mesActual,
                nombre: item.nombre,
                precio: item.precio,
                categoria: item.categoria
              });
              
              count++;
            } catch (e: any) {
              // console.warn("Error BD:", e);
              dbErrores++;
              if (!dbErrorMsg) dbErrorMsg = e.message || "Error desconocido BD";
            }
          }));
        }

        if (dbErrores > 0) {
           resultMsg!.textContent = `Atención: ${count} guardados, pero fallaron ${dbErrores} por error: ${dbErrorMsg}`;
           resultMsg!.style.color = "#ef4444";
           btnConfirm.disabled = false;
           return;
        }

        resultMsg!.textContent = `✓ ¡Sincronización Exitosa! ${count} registros actualizados.`;
        resultMsg!.style.color = "#059669";
        
        setTimeout(() => { window.location.replace("/inven"); }, 2000);
      });
    </script>
  </body>
</html>
