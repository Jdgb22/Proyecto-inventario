---
import Navbar from "../components/navbar.astro";
---

<!DOCTYPE html>
<html lang="es-co">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Carga Masiva de Inventario</title>
    <style>
      body { font-family: 'Inter', -apple-system, sans-serif; background-color: #f9fafb; margin: 0; }
      main { max-width: 1000px; margin: 40px auto; padding: 24px; background: white; border-radius: 12px; box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1); }
      h1 { color: #111827; margin-top: 0; margin-bottom: 24px; font-weight: 800; letter-spacing: -0.025em; }
      .upload-container { border: 2px dashed #cbd5e1; padding: 48px; text-align: center; border-radius: 12px; margin-bottom: 24px; transition: all 0.2s; background: #f8fafc; cursor: pointer; }
      .upload-container:hover { border-color: #3b82f6; background-color: #eff6ff; }
      #file-input { display: none; }
      .btn { padding: 12px 24px; background: #3b82f6; color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: 700; font-size: 1rem; transition: all 0.2s; }
      .btn:hover:not(:disabled) { background: #2563eb; transform: translateY(-1px); }
      .btn:disabled { background: #94a3b8; cursor: not-allowed; }
      .btn-success { background: #10b981; }
      .btn-success:hover { background: #059669; }
      .table-container { overflow-x: auto; margin-top: 24px; display: none; }
      table { width: 100%; border-collapse: collapse; text-align: left; }
      th, td { padding: 14px; border-bottom: 1px solid #e2e8f0; }
      th { background-color: #f1f5f9; font-weight: 700; color: #475569; font-size: 0.85rem; text-transform: uppercase; }
      .status-new { color: #065f46; background: #d1fae5; padding: 4px 10px; border-radius: 9999px; font-size: 0.75rem; font-weight: 700; }
      .status-update { color: #92400e; background: #fef3c7; padding: 4px 10px; border-radius: 9999px; font-size: 0.75rem; font-weight: 700; }
      #loading-msg { color: #64748b; font-style: italic; margin-top: 12px; display: none; }
      .actions { display: flex; justify-content: space-between; align-items: center; margin-top: 24px; padding-top: 24px; border-top: 1px solid #e2e8f0; }
      .info-banner { background-color: #f0f9ff; border: 1px solid #bae6fd; color: #0369a1; padding: 16px; border-radius: 8px; margin-bottom: 24px; font-size: 0.9rem; line-height: 1.5; }
    </style>
  </head>
  <body>
    <Navbar />
    
    <main>
      <h1>Cargar Inventario del Mes</h1>
      
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 24px;">
        <label style="display: flex; flex-direction: column; gap: 8px; font-weight: 600; color: #374151;">
          Sede de Registro:
          <select id="inv-negocio" style="padding: 12px; border: 1px solid #e2e8f0; border-radius: 8px; font-size: 1rem;"></select>
        </label>
        <label style="display: flex; flex-direction: column; gap: 8px; font-weight: 600; color: #374151;">
          Mes de Registro:
          <input id="inv-mes" type="month" required style="padding: 12px; border: 1px solid #e2e8f0; border-radius: 8px; font-size: 1rem;"/>
        </label>
      </div>

      <div class="info-banner">
        <strong>⚡ Sincronización Inteligente:</strong> Al subir el archivo, el sistema actualizará los nombres y precios en la <strong>Base de Datos</strong> general y registrará la <strong>Cantidad</strong> en el inventario del mes para la sede seleccionada.
      </div>

      <div class="upload-container" id="drop-zone" onclick="document.getElementById('file-input').click()">
        <svg style="width:56px; height:56px; color:#cbd5e1; margin: 0 auto 12px;" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 13h6m-3-3v6m5 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
        <p style="font-size: 1.125rem; color: #1e293b; margin:0;"><strong>Haz clic o arrastra tu archivo Excel</strong></p>
        <p style="font-size: 0.875rem; color: #64748b; margin-top: 6px;">Columnas requeridas: Código, Nombre, Cantidad, Precio.</p>
        <input type="file" id="file-input" accept=".xlsx, .xls, .csv" />
      </div>

      <p id="loading-msg">Procesando archivo... un momento.</p>

      <div class="table-container" id="preview-container">
        <h2 style="margin-bottom: 16px;">Confirmación de Carga</h2>
        <div style="background: white; border: 1px solid #e2e8f0; border-radius: 8px; overflow: hidden;">
          <table id="preview-table">
            <thead>
              <tr>
                <th>Código</th>
                <th>Nombre</th>
                <th>Precio (Base Datos)</th>
                <th>Cantidad (Mes)</th>
                <th>Estado</th>
              </tr>
            </thead>
            <tbody id="preview-body"></tbody>
          </table>
        </div>
        <div class="actions">
          <p id="result-msg" style="font-weight: 700;"></p>
          <button id="btn-confirm" class="btn btn-success">Sincronizar Inventario</button>
        </div>
      </div>
    </main>

    <script>
      import * as XLSX from "xlsx";
      import { getStockFiltrado, upsertMasterProducto, updateInventario, addInventario } from "../lib/inventory";
      import { getNegocios } from "../lib/negocios";

      const XLSX_LIB = (window as any).XLSX || XLSX;

      let stockActualEnDB: any[] = [];
      let itemsParaSync: any[] = [];
      let negocioActual = "";
      let mesActual = "";

      async function init() {
        const negSelect = document.getElementById("inv-negocio") as HTMLSelectElement;
        const mesInput = document.getElementById("inv-mes") as HTMLInputElement;
        const now = new Date();
        mesInput.value = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;

        try {
          const negocios = await getNegocios();
          if (negSelect) {
            negSelect.innerHTML = negocios.map(n => `<option value="${n.nombre}">${n.nombre}</option>`).join("");
          }
        } catch (e) {
          console.error(e);
        }
      }
      init();

      const fileInput = document.getElementById("file-input") as HTMLInputElement;
      const dropZone = document.getElementById("drop-zone");
      const loadingMsg = document.getElementById("loading-msg");
      const previewContainer = document.getElementById("preview-container");
      const previewBody = document.getElementById("preview-body");
      const btnConfirm = document.getElementById("btn-confirm") as HTMLButtonElement;
      const resultMsg = document.getElementById("result-msg");
      const filterNeg = document.getElementById("inv-negocio") as HTMLSelectElement;
      const filterMes = document.getElementById("inv-mes") as HTMLInputElement;

      dropZone?.addEventListener("dragover", (e) => { e.preventDefault(); dropZone.style.borderColor = "#3b82f6"; });
      dropZone?.addEventListener("dragleave", () => { dropZone.style.borderColor = "#cbd5e1"; });
      dropZone?.addEventListener("drop", (e) => {
        e.preventDefault();
        dropZone.style.borderColor = "#cbd5e1";
        if (e.dataTransfer?.files.length) processFile(e.dataTransfer.files[0]);
      });

      fileInput?.addEventListener("change", (e: any) => { if (e.target.files?.length) processFile(e.target.files[0]); });

      async function processFile(file: File) {
        negocioActual = filterNeg.value;
        mesActual = filterMes.value;

        if (!negocioActual || !mesActual) {
          alert("Selecciona primero la Sede y el Mes."); return;
        }

        loadingMsg!.style.display = "block";
        previewContainer!.style.display = "none";
        
        try {
          stockActualEnDB = await getStockFiltrado(negocioActual, mesActual);

          const reader = new FileReader();
          reader.onload = (e: any) => {
            const arr = new Uint8Array(e.target.result);
            const wb = XLSX_LIB.read(arr, { type: 'array' });
            const sheet = wb.Sheets[wb.SheetNames[0]];
            const rawJson = XLSX_LIB.utils.sheet_to_json(sheet);
            displayPreview(rawJson);
          };
          reader.readAsArrayBuffer(file);
        } catch (error) {
          console.error(error);
          alert("Error en validación.");
          loadingMsg!.style.display = "none";
        }
      }

      function displayPreview(data: any[]) {
        previewBody!.innerHTML = "";
        itemsParaSync = data.map(row => {
          const nombre = row.Nombre || row.nombre || row.Producto || "Sin nombre";
          const codigo = String(row.Codigo || row.codigo || row.SKU || "").trim();
          const cantidad = parseInt(row.Cantidad || row.cantidad || 0);
          const precio = parseFloat(row.Precio || row.precio || 0);
          const categoria = row.Categoria || row.categoria || "";

          const match = stockActualEnDB.find(i => String(i.codigo).trim() === codigo);
          
          return {
            nombre, codigo, cantidad, precio, categoria,
            existingId: match?.id || null,
            prevStock: match ? match.cantidad : 0,
            sumResult: (match ? match.cantidad : 0) + cantidad
          };
        });

        itemsParaSync.forEach(item => {
          const tr = document.createElement("tr");
          tr.innerHTML = `
            <td style="font-family:monospace; font-weight:600;">${item.codigo}</td>
            <td style="font-weight:500;">${item.nombre}</td>
            <td style="color:#059669; font-weight:600;">$${item.precio.toLocaleString()}</td>
            <td><strong>+ ${item.cantidad}</strong> <span style="color:#94a3b8; font-size:0.8rem;">(Total: ${item.sumResult})</span></td>
            <td><span class="${item.existingId ? 'status-update' : 'status-new'}">${item.existingId ? 'Suma a Existente' : 'Nueva Entrada'}</span></td>
          `;
          previewBody!.appendChild(tr);
        });

        loadingMsg!.style.display = "none";
        previewContainer!.style.display = "block";
      }

      btnConfirm.addEventListener("click", async () => {
        btnConfirm.disabled = true;
        resultMsg!.textContent = "Sincronizando... por favor no cierres la ventana.";
        resultMsg!.style.color = "#475569";
        
        let count = 0;

        for (const item of itemsParaSync) {
          try {
            // 1. Sincronizar Base de Datos Maestra
            await upsertMasterProducto({
                nombre: item.nombre,
                codigo: item.codigo,
                precio: item.precio,
                categoria: item.categoria
            });

            // 2. Sincronizar Inventario Mensual
            const payload = {
              nombre: item.nombre,
              codigo: item.codigo,
              negocio: negocioActual,
              mes: mesActual,
              cantidad: item.sumResult
            };

            if (item.existingId) {
              await updateInventario(item.existingId, payload);
            } else {
              await addInventario(payload);
            }
            count++;
          } catch (e) {
            console.error(e);
          }
        }

        resultMsg!.textContent = `✓ ¡Listo! ${count} registros procesados con éxito. Redirigiendo...`;
        resultMsg!.style.color = "#059669";
        
        setTimeout(() => { window.location.replace("/inven"); }, 2000);
      });
    </script>
  </body>
</html>
