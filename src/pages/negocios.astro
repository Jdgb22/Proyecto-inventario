---
import Navbar from "../components/navbar.astro";
---

<!DOCTYPE html>
<html lang="es-co">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sedes | Gestión de Negocios Premium</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <style is:global>
      body { font-family: 'Inter', system-ui, -apple-system, sans-serif; background-color: #f8fafc; margin: 0; color: #0f172a; }
      
      .main-container { max-width: 1400px; margin: 0 auto; padding: 32px 24px; }

      .page-hero {
        background: white; border: 1px solid #e2e8f0; border-radius: 24px; padding: 32px;
        margin-bottom: 32px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05); display: flex;
        justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; position: relative; overflow: hidden;
      }
      .page-hero::after {
        content: ""; position: absolute; top: 0; right: 0; width: 300px; height: 100%;
        background: radial-gradient(ellipse at top right, rgba(245, 158, 11, 0.1), transparent 70%); pointer-events: none;
      }
      .hero-content { flex: 1; min-width: 300px; z-index: 1; }
      
      .page-hero__badge {
        display: inline-flex; align-items: center; gap: 6px; font-size: 0.7rem; font-weight: 800; text-transform: uppercase;
        letter-spacing: 0.1em; color: #b45309; background: #fffbeb; border: 1px solid #fde68a;
        padding: 6px 14px; border-radius: 999px; margin-bottom: 16px;
      }
      .page-hero__badge::before {
        content: ""; width: 8px; height: 8px; border-radius: 50%; background: #f59e0b;
        box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.25);
      }
      
      .page-hero__title { margin: 0 0 12px 0; font-size: 2.25rem; font-weight: 800; color: #0f172a; letter-spacing: -0.03em; }
      .page-hero__desc { margin: 0; font-size: 1rem; color: #64748b; line-height: 1.6; max-width: 65ch; }

      .split-layout { display: grid; grid-template-columns: 1fr 400px; gap: 32px; align-items: start; }
      @media (max-width: 1024px) { .split-layout { grid-template-columns: 1fr; } }

      .sidebar-section { position: sticky; top: 100px; }

      .form-card { 
        background: white; padding: 32px; border-radius: 24px; border: 1px solid #e2e8f0; 
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.05); transition: all 0.3s;
      }
      .form-card.edit-mode {
        border-color: #f59e0b; box-shadow: 0 20px 25px -5px rgba(245, 158, 11, 0.1);
      }
      
      .form-header { margin-bottom: 24px; padding-bottom: 16px; border-bottom: 1px solid #f1f5f9; display: flex; justify-content: space-between; align-items: center; }
      .form-title { font-size: 1.25rem; font-weight: 800; margin: 0; color: #0f172a; }

      .btn-cancel-edit {
        display: none; background: #f1f5f9; color: #64748b; border: none; padding: 6px 12px;
        border-radius: 8px; font-size: 0.75rem; font-weight: 700; cursor: pointer; transition: all 0.2s;
      }
      .form-card.edit-mode .btn-cancel-edit { display: block; }
      .btn-cancel-edit:hover { background: #e2e8f0; color: #0f172a; }
      
      .form-group { display: flex; flex-direction: column; gap: 8px; margin-bottom: 20px; }
      label { font-size: 0.75rem; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em; }
      input { padding: 14px 16px; border: 1px solid #cbd5e1; border-radius: 12px; font-size: 1rem; background: #f8fafc; transition: all 0.2s; color: #0f172a; }
      input:focus { outline: none; border-color: #f59e0b; box-shadow: 0 0 0 4px rgba(245, 158, 11, 0.15); background: white; }
      
      .btn-submit { 
        width: 100%; padding: 16px; background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); 
        color: white; border: none; border-radius: 14px; cursor: pointer; font-weight: 800; font-size: 1rem;
        margin-top: 12px; transition: all 0.3s; box-shadow: 0 10px 15px -3px rgba(245, 158, 11, 0.3);
      }
      .btn-submit:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 14px 20px -3px rgba(245, 158, 11, 0.4); }
      .btn-submit:disabled { opacity: 0.7; cursor: not-allowed; }
      
      #msg { text-align: center; font-weight: 600; margin-top: 16px; font-size: 0.9rem; }

      .list-section { display: flex; flex-direction: column; gap: 24px; }
      
      .list-header {
        display: flex; justify-content: space-between; align-items: center; background: white;
        padding: 16px 24px; border-radius: 16px; border: 1px solid #e2e8f0;
      }
      .list-title-group { display: flex; flex-direction: column; gap: 4px; }
      .context-hint { font-size: 0.85rem; color: #64748b; margin: 0; }
      
      .list-count {
        font-weight: 700; color: #d97706; background: #fffbeb;
        padding: 4px 12px; border-radius: 999px; font-size: 0.85rem; border: 1px solid #fef3c7;
      }

      #lista-sedes { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 20px; }
      
      .sede-card { 
        background: white; padding: 24px; border-radius: 20px; border: 1px solid #e2e8f0; 
        display: flex; flex-direction: column; gap: 20px; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative; overflow: hidden;
      }
      .sede-card.is-editing { border-color: #f59e0b; box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.2); }
      .sede-card:hover { transform: translateY(-4px); box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.05); border-color: #cbd5e1; }
      .sede-card::before { 
        content: ""; position: absolute; left: 0; top: 0; width: 100%; height: 4px; 
        background: linear-gradient(90deg, #fbbf24, #f59e0b); opacity: 0; transition: opacity 0.3s;
      }
      .sede-card:hover::before, .sede-card.is-editing::before { opacity: 1; }

      .card-info { display: flex; flex-direction: column; gap: 8px; }
      .sede-name { font-size: 1.4rem; font-weight: 800; color: #0f172a; line-height: 1.2; display: flex; align-items: center; gap: 8px; }

      .card-actions { display: flex; gap: 12px; margin-top: auto; border-top: 1px solid #f1f5f9; padding-top: 16px; }
      
      .btn-edit { 
        flex: 1; padding: 10px; background: white; color: #d97706; border: 1px solid #fde68a; 
        border-radius: 10px; cursor: pointer; font-weight: 700; font-size: 0.85rem; transition: all 0.2s; 
      }
      .btn-edit:hover { background: #fffbeb; border-color: #fcd34d; }
      
      .btn-delete { 
        flex: 1; padding: 10px; background: white; color: #ef4444; border: 1px solid #fecaca; 
        border-radius: 10px; cursor: pointer; font-weight: 700; font-size: 0.85rem; transition: all 0.2s; 
      }
      .btn-delete:hover { background: #fef2f2; border-color: #ef4444; }

      .empty-state {
        grid-column: 1 / -1; background: white; border: 1px dashed #cbd5e1; border-radius: 20px;
        padding: 60px 24px; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 16px;
      }
    </style>
  </head>
  <body>
    <Navbar />
    
    <div class="main-container">
      <header class="page-hero">
        <div class="hero-content">
          <span class="page-hero__badge">Configuración Global</span>
          <h1 class="page-hero__title">Directorio de Sedes</h1>
          <p class="page-hero__desc">
            Administra los nombres y existencias base de tus diferentes locales, tiendas o sucursales físicas.
          </p>
        </div>
      </header>

      <div class="split-layout">
        
        <!-- Left Column: List -->
        <div class="list-section">
          <div class="list-header">
            <div class="list-title-group">
              <h2 style="margin:0; font-size:1.1rem; font-weight:800; color: #0f172a;">Locales Activos</h2>
            </div>
            <span class="list-count" id="list-count">Cargando...</span>
          </div>

          <ul id="lista-sedes">
            <li class="empty-state">
              <span style="font-size: 24px;">🏢</span>
              <span style="color: #64748b; font-weight: 500;">Cargando lista de negocios...</span>
            </li>
          </ul>
        </div>

        <!-- Right Column: Form -->
        <div class="sidebar-section">
          <div class="form-card" id="main-form-card">
            <div class="form-header">
              <div>
                <h3 class="form-title" id="form-title">Añadir Sede</h3>
                <p id="form-desc" style="margin: 6px 0 0 0; color: #64748b; font-size: 0.85rem;">Crea un nuevo comercio para tu gestión.</p>
              </div>
              <button type="button" class="btn-cancel-edit" id="btn-cancel-edit">Cancelar</button>
            </div>
            
            <form id="form-sede">
              <input type="hidden" id="edit-id" value="" />

              <div class="form-group">
                  <label for="s-nombre">Nombre de la Sede</label>
                  <input type="text" id="s-nombre" placeholder="Ej: Sucursal Centro" required />
              </div>
              
              <button type="submit" id="btn-submit" class="btn-submit">Registrar Base</button>
            </form>
            <p id="msg"></p>
          </div>
        </div>

      </div>
    </div>

    <script>
      import { getSession, getUserRole } from "../lib/auth";
      import { getNegocios, addNegocio, updateNegocio, deleteNegocio } from "../lib/negocios";

      const state = { editingId: null as string | null };

      async function init() {
        const session = await getSession();
        if (!session) { window.location.replace("/"); return; }
        const role = await getUserRole(session.user.id);
        if (role !== "admin" && role !== "superadmin") { window.location.replace("/init"); return; }
        loadData();
      }

      function startEdit(item: any) {
        (document.getElementById('edit-id') as HTMLInputElement).value = item.id;
        (document.getElementById('s-nombre') as HTMLInputElement).value = item.nombre;
        
        const formCard = document.getElementById('main-form-card')!;
        formCard.classList.add('edit-mode');
        document.getElementById('form-title')!.textContent = "Renombrar Sede";
        document.getElementById('form-desc')!.textContent = "Cambiando detalles de la sucursal.";
        document.getElementById('btn-submit')!.textContent = "Actualizar Cambios";
        
        state.editingId = item.id;
        
        document.querySelectorAll('.sede-card').forEach(el => el.classList.remove('is-editing'));
        document.getElementById(`card-${item.id}`)?.classList.add('is-editing');
        
        if(window.innerWidth <= 1024) formCard.scrollIntoView({ behavior: 'smooth' });
      }

      function cancelEdit() {
        state.editingId = null;
        const form = document.getElementById("form-sede") as HTMLFormElement;
        form.reset();
        (document.getElementById('edit-id') as HTMLInputElement).value = "";
        
        const formCard = document.getElementById('main-form-card')!;
        formCard.classList.remove('edit-mode');
        document.getElementById('form-title')!.textContent = "Añadir Sede";
        document.getElementById('form-desc')!.textContent = "Crea un nuevo comercio para tu gestión.";
        document.getElementById('btn-submit')!.textContent = "Registrar Base";
        
        document.querySelectorAll('.sede-card').forEach(el => el.classList.remove('is-editing'));
      }

      document.getElementById("btn-cancel-edit")?.addEventListener("click", cancelEdit);

      async function loadData() {
        const lista = document.getElementById("lista-sedes")!;
        const count = document.getElementById("list-count")!;

        try {
          const data = await getNegocios();
          count.textContent = `${data.length} ${data.length === 1 ? 'sede' : 'sedes'}`;

          if (!data || data.length === 0) {
              lista.innerHTML = `
                <li class="empty-state">
                  <span style="font-size: 24px;">🏬</span>
                  <span style="color: #64748b; font-weight: 500;">Aún no has creado ninguna sucursal o sede física.</span>
                </li>`;
              return;
          }

          lista.innerHTML = "";
          
          data.forEach(item => {
            const li = document.createElement("li");
            li.className = "sede-card";
            li.id = `card-${item.id}`;
            if (state.editingId === item.id) li.classList.add('is-editing');
            
            li.innerHTML = `
              <div class="card-info">
                <span class="sede-name">📍 ${item.nombre}</span>
              </div>
              <div class="card-actions">
                <button class="btn-edit" data-item='${JSON.stringify(item)}'>Editar</button>
                <button class="btn-delete" data-id="${item.id}" data-nombre="${item.nombre}">Eliminar</button>
              </div>
            `;
            lista.appendChild(li);
          });

          document.querySelectorAll('.btn-edit').forEach(btn => {
            btn.addEventListener('click', (e: any) => {
              const itemData = JSON.parse(e.target.dataset.item);
              startEdit(itemData);
            });
          });

          document.querySelectorAll('.btn-delete').forEach(btn => {
            btn.addEventListener('click', async (e: any) => {
              if (confirm(`¿Eliminar la sede "${e.target.dataset.nombre}" permanentemente? Esto puede afectar tu inventario asignado a esta sede.`)) {
                await deleteNegocio(e.target.dataset.id);
                if(state.editingId === e.target.dataset.id) cancelEdit();
                loadData();
              }
            });
          });
        } catch (e) {
          // console.warn(e);
          count.textContent = "Error";
        }
      }

      document.getElementById("form-sede")?.addEventListener("submit", async (e: any) => {
        e.preventDefault();
        const msg = document.getElementById("msg")!;
        const btn = document.getElementById("btn-submit") as HTMLButtonElement;
        const editId = (document.getElementById("edit-id") as HTMLInputElement).value;
        const isUpdate = editId.trim().length > 0;

        try {
          msg.textContent = "";
          btn.disabled = true;
          btn.textContent = "Guardando...";

          const nombreVal = (document.getElementById("s-nombre") as HTMLInputElement).value;

          if (isUpdate) {
            await updateNegocio(editId, nombreVal);
            msg.textContent = "✓ Sede renombrada exitosamente";
          } else {
            await addNegocio(nombreVal);
            msg.textContent = "✓ Sucursal creada con éxito";
          }
          
          msg.style.color = "#10b981";
          
          cancelEdit();
          loadData();
          
          setTimeout(() => { msg.textContent = ""; }, 3000);
        } catch (err: any) {
          msg.textContent = "Error: " + err.message;
          msg.style.color = "#ef4444";
        } finally {
          btn.disabled = false;
          if(!state.editingId) btn.textContent = "Registrar Base";
        }
      });

      init();
    </script>
  </body>
</html>
