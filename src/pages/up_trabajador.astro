---
import Navbar from "../components/navbar.astro";
---

<!DOCTYPE html>
<html lang="es-co">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Subir Trabajadores</title>
    
    <!-- Premium Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <style>
      body { font-family: 'Inter', system-ui, -apple-system, sans-serif; background-color: #f3f4f6; margin: 0; color: #1f2937; }
      .container { padding: 24px; max-width: 1100px; margin: 0 auto; }
      
      .header-flex { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 16px; }
      h1 { font-size: 1.8rem; font-weight: 800; color: #111827; margin: 0; letter-spacing: -0.025em; }
      
      .main-card { background: white; padding: 32px; border-radius: 20px; border: 1px solid #e5e7eb; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); margin-bottom: 32px; }
      
      .form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 24px; }
      .form-group { display: flex; flex-direction: column; gap: 8px; }
      label { font-size: 0.75rem; font-weight: 700; color: #6b7280; text-transform: uppercase; letter-spacing: 0.05em; }
      input, select { padding: 12px; border: 1px solid #d1d5db; border-radius: 12px; font-size: 1rem; background: #f9fafb; transition: all 0.2s; }
      input:focus { outline: none; border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1); background: white; }
      
      .btn { padding: 12px 24px; border: none; border-radius: 12px; cursor: pointer; font-weight: 700; font-size: 0.95rem; transition: all 0.2s; display: inline-flex; align-items: center; justify-content: center; gap: 8px; }
      .btn-gray { background: #64748b; color: white; }
      .btn-gray:hover { background: #475569; transform: translateY(-1px); }
      .btn-success { background: #10b981; color: white; }
      .btn-success:hover { background: #059669; transform: translateY(-1px); box-shadow: 0 10px 15px -3px rgba(16, 185, 129, 0.3); }

      .upload-zone { border: 2px dashed #cbd5e1; padding: 50px 32px; text-align: center; border-radius: 16px; background: #f8fafc; cursor: pointer; transition: all 0.3s ease; margin-bottom: 32px; }
      .upload-zone:hover { border-color: #3b82f6; background-color: #eff6ff; }
      .upload-icon { width: 56px; height: 56px; color: #94a3b8; margin: 0 auto 12px; }
      #file-input { display: none; }

      .preview-section { display: none; margin-top: 32px; animation: slideUp 0.4s ease-out; }
      @keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

      .preview-list { display: grid; grid-template-columns: 1fr; gap: 12px; margin-top: 16px; max-height: 500px; overflow-y: auto; padding-right: 8px; }
      .worker-preview-card { background: #f8fafc; padding: 16px; border-radius: 12px; border: 1px solid #e2e8f0; display: grid; grid-template-columns: 2fr 1fr 1fr 1fr 120px; align-items: center; gap: 16px; }
      
      .worker-name { font-weight: 700; color: #1e293b; font-size: 1rem; }
      .worker-doc { font-family: monospace; color: #64748b; background: #e2e8f0; padding: 2px 6px; border-radius: 4px; font-size: 0.8rem; }
      .salary-val { color: #059669; font-weight: 700; }
      .status-pill { font-size: 0.7rem; font-weight: 800; text-transform: uppercase; padding: 4px 10px; border-radius: 9999px; text-align: center; }
      .status-new { background: #d1fae5; color: #065f46; }
      .status-update { background: #fef3c7; color: #92400e; }
      .status-error { background: #fee2e2; color: #b91c1c; }

      .actions-footer { margin-top: 24px; display: flex; justify-content: space-between; align-items: center; padding-top: 24px; border-top: 2px solid #f1f5f9; }
      #loading-msg { text-align: center; color: #64748b; font-weight: 600; margin-top: 20px; display: none; }
    </style>
  </head>
  <body>
    <Navbar />
    
    <div class="container">
      <div class="header-flex">
        <h1>Carga Masiva de Trabajadores</h1>
        <button id="btn-template" class="btn btn-gray">
          <svg style="width:20px; height:20px;" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
          Descargar Plantilla
        </button>
      </div>

      <div class="main-card">
        <div class="form-grid">
            <div class="form-group">
                <label>Negocio / Sede</label>
                <input id="worker-negocio" type="text" list="negocios-list" placeholder="Selecciona el negocio" required />
                <datalist id="negocios-list"></datalist>
            </div>
            <div class="form-group">
                <label>Mes de Registro</label>
                <input id="worker-mes" type="month" required />
            </div>
        </div>

        <div class="upload-zone" id="drop-zone" onclick="document.getElementById('file-input').click()">
            <svg class="upload-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 13h6m-3-3v6m5 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
            <p style="font-size: 1.1rem; color: #1e293b; margin:0;"><strong>Haz clic o arrastra tu archivo Excel</strong></p>
            <p style="font-size: 0.85rem; color: #64748b; margin-top: 8px;">Columnas: Nombre, Documento, Teléfono, Cargo, Extras, Deuda.</p>
            <input type="file" id="file-input" accept=".xlsx, .xls, .csv" />
        </div>

        <p id="loading-msg">Validando información con el sistema...</p>

        <div class="preview-section" id="preview-section">
            <h3 style="margin-bottom: 16px; font-size: 1.1rem; color: #4b5563;">Confirmación de Trabajadores Próximos a Cargar</h3>
            
            <div class="preview-list" id="preview-list"></div>

            <div class="actions-footer">
                <p id="result-msg" style="font-weight: 700; margin: 0;"></p>
                <button id="btn-confirm" class="btn btn-success">Finalizar e Importar Datos</button>
            </div>
        </div>
      </div>
    </div>

    <script>
      import * as XLSX from "xlsx";
      import { getTrabajadoresFiltrados, getTrabajadores, addTrabajador, updateTrabajador } from "../lib/workers";
      import { getNegocios } from "../lib/negocios";
      import { getSession } from "../lib/auth";

      const XLSX_LIB = (window as any).XLSX || XLSX;

      let trabajadoresActuales: any[] = [];
      let datosAProcesar: any[] = [];
      let negocioSeleccionado = "";
      let mesSeleccionado = "";

      async function checkAuth() {
        try {
          const session = await getSession();
          if (!session) window.location.replace("/");
        } catch (e) {
          console.warn("Auth check failed:", e);
        }
      }
      checkAuth();

      const fileInput = document.getElementById("file-input") as HTMLInputElement;
      const dropZone = document.getElementById("drop-zone");
      const loadingMsg = document.getElementById("loading-msg");
      const previewSection = document.getElementById("preview-section");
      const previewList = document.getElementById("preview-list");
      const btnConfirm = document.getElementById("btn-confirm") as HTMLButtonElement;
      const resultMsg = document.getElementById("result-msg");
      const negocioInput = document.getElementById("worker-negocio") as HTMLInputElement;
      const negociosDatalist = document.getElementById("negocios-list");
      const mesInput = document.getElementById("worker-mes") as HTMLInputElement;
      const btnTemplate = document.getElementById("btn-template");

      btnTemplate?.addEventListener("click", () => {
        const headers = [
          ["Nombre", "Documento", "Teléfono", "Cargo", "Horas Extras", "Deuda"],
          ["Ejemplo Nombre", "123456", "300000000", "Operario", 0, 0]
        ];
        const ws = XLSX_LIB.utils.aoa_to_sheet(headers);
        const wb = XLSX_LIB.utils.book_new();
        XLSX_LIB.utils.book_append_sheet(wb, ws, "Plantilla");
        XLSX_LIB.writeFile(wb, "plantilla_trabajadores.xlsx");
      });

      async function loadNegocios() {
        try {
          const negs = await getNegocios();
          if (negociosDatalist) {
            negociosDatalist.innerHTML = negs.map(n => `<option value="${n.nombre}">${n.nombre}</option>`).join("");
          }
        } catch (error) { console.error(error); }
      }
      loadNegocios();

      dropZone?.addEventListener("dragover", (e) => { e.preventDefault(); dropZone.style.borderColor = "#3b82f6"; });
      dropZone?.addEventListener("dragleave", () => { dropZone.style.borderColor = "#cbd5e1"; });
      dropZone?.addEventListener("drop", (e) => {
        e.preventDefault();
        if (e.dataTransfer?.files.length) handleFile(e.dataTransfer.files[0]);
      });
      fileInput?.addEventListener("change", (e: any) => { if (e.target.files?.length) handleFile(e.target.files[0]); });

      async function handleFile(file: File) {
        negocioSeleccionado = negocioInput.value.trim();
        mesSeleccionado = mesInput.value.trim();

        if (!negocioSeleccionado || !mesSeleccionado) {
          alert("Selecciona Negocio y Mes."); return;
        }

        loadingMsg!.style.display = "block";
        previewSection!.style.display = "none";
        
        try {
          trabajadoresActuales = await getTrabajadoresFiltrados(negocioSeleccionado, mesSeleccionado);
          const reader = new FileReader();
          reader.onload = (e: any) => {
            const data = new Uint8Array(e.target.result);
            const wb = XLSX_LIB.read(data, { type: "array" });
            const json = XLSX_LIB.utils.sheet_to_json(wb.Sheets[wb.SheetNames[0]], { defval: "" });
            procesarJSON(json);
          };
          reader.readAsArrayBuffer(file);
        } catch (error: any) { alert(error.message); loadingMsg!.style.display = "none"; }
      }

      function procesarJSON(data: any[]) {
        previewList!.innerHTML = "";
        datosAProcesar = data.map((row: any) => {
          const r: any = {};
          Object.keys(row).forEach(k => r[k.toLowerCase().trim()] = row[k]);
          
          const nombre = String(r["nombre"] || "").trim();
          const documento = String(r["documento"] || "").trim();
          const horas = parseFloat(r["horas_extras"] || r["extras"] || 0);
          const deuda = parseFloat(r["deuda"] || 0);

          const existing = trabajadoresActuales.find(t => String(t.documento).trim() === documento);
          
          return {
            dbId: existing?.id,
            nombre, documento, 
            tel: r["teléfono"] || r["telefono"] || "",
            cargo: r["cargo"] || "",
            horas, deuda,
            isValid: (nombre !== "" && documento !== ""),
            status: existing ? "status-update" : "status-new",
            statusText: existing ? "Existente" : "Nuevo"
          };
        });

        datosAProcesar.forEach(item => {
          const card = document.createElement("div");
          card.className = "worker-preview-card";
          card.innerHTML = `
            <div>
                <div class="worker-name">${item.nombre}</div>
                <span class="worker-doc">${item.documento}</span>
            </div>
            <div style="font-size:0.85rem; color:#64748b;">${item.cargo || '-'}</div>
            <div style="font-size:0.85rem;">Extras: <strong>${item.horas}</strong></div>
            <div style="color:#ef4444; font-weight:700;">Deuda: $${item.deuda.toLocaleString()}</div>
            <div class="status-pill ${item.status}">${item.statusText}</div>
          `;
          previewList!.appendChild(card);
        });

        loadingMsg!.style.display = "none";
        previewSection!.style.display = "block";
      }

      btnConfirm?.addEventListener("click", async () => {
        btnConfirm.disabled = true;
        resultMsg!.textContent = "Sincronizando nómina...";
        
        let count = 0;
        for (const item of datosAProcesar.filter(i => i.isValid)) {
          try {
            const payload = {
              nombre: item.nombre, documento: item.documento,
              telefono: item.tel, cargo: item.cargo,
              horas_extras: item.horas, deuda: item.deuda,
              negocio: negocioSeleccionado, mes: mesSeleccionado
            };
            if (item.dbId) await updateTrabajador(item.dbId, payload);
            else await addTrabajador(payload as any);
            count++;
          } catch (e) { console.error(e); }
        }
        resultMsg!.textContent = `✓ ¡Sincronizado! ${count} trabajadores procesados.`;
        resultMsg!.style.color = "#059669";
        setTimeout(() => window.location.replace("/reportes_trabajadores"), 2000);
      });
    </script>
  </body>
</html>
