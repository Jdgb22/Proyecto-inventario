---
import Navbar from "../components/navbar.astro";
---

<!DOCTYPE html>
<html lang="es-co">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reportes de Inventario Mensual</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
      body { font-family: 'Inter', system-ui, sans-serif; background-color: #f1f5f9; margin: 0; color: #1e293b; }
      main { max-width: 1200px; margin: 40px auto; padding: 24px; }
      h1 { color: #0f172a; margin-top: 0; margin-bottom: 28px; font-weight: 800; }
      .card { background: white; padding: 28px; border-radius: 20px; border: 1px solid #e2e8f0; box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1); margin-bottom: 28px; }
      .filters { display: flex; gap: 20px; flex-wrap: wrap; align-items: flex-end; }
      label { display: flex; flex-direction: column; gap: 8px; font-weight: 700; color: #475569; font-size: 0.875rem; }
      input, select { padding: 12px; border: 1px solid #e2e8f0; border-radius: 10px; font-size: 1rem; width: 100%; transition: border-color 0.2s; }
      input:focus, select:focus { outline: none; border-color: #3b82f6; }
      button { padding: 12px 32px; background-color: #3b82f6; color: white; border: none; border-radius: 10px; cursor: pointer; font-weight: 700; font-size: 1rem; transition: background 0.2s; }
      button:hover { background-color: #2563eb; }
      .stats-container { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; margin-bottom: 32px; }
      .stat-card { background: white; padding: 24px; border-radius: 16px; border: 1px solid #e2e8f0; display: flex; flex-direction: column; }
      .stat-card h4 { margin: 0; color: #64748b; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px; }
      .stat-card .value { font-size: 1.75rem; font-weight: 800; color: #1e293b; }
      .chart-card { background: white; padding: 24px; border-radius: 16px; border: 1px solid #e2e8f0; height: 100%; }
      .chart-container { height: 350px; position: relative; }
      table { width: 100%; border-collapse: collapse; margin-top: 15px; }
      th, td { padding: 16px; border-bottom: 1px solid #f1f5f9; text-align: left; }
      th { color: #64748b; font-weight: 700; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; }
    </style>
  </head>
  <body>
    <Navbar />

    <main>
      <h1>Reportes de Inventario</h1>

      <div class="card">
        <div class="filters">
          <label style="flex: 1.5; min-width: 280px;">
            Sede / Negocio
            <select id="report-negocio">
              <option value="">Cargando sedes...</option>
            </select>
          </label>

          <label style="flex: 1; min-width: 180px;">
            Mes / Periodo
            <input id="report-mes" type="month" />
          </label>

          <button id="btn-generate">Generar Reporte Mensual</button>
        </div>
      </div>

      <div id="no-data-msg" style="padding: 60px; text-align: center; color: #94a3b8; font-style: italic;">
        Ingresa los parámetros para generar el reporte de existencias.
      </div>

      <div id="report-content" style="display: none;">
        <div class="stats-container">
          <div class="stat-card" style="border-left: 5px solid #3b82f6;">
            <h4>Lineas de Producto</h4>
            <div id="val-total-prods" class="value">0</div>
          </div>
          <div class="stat-card" style="border-left: 5px solid #10b981;">
            <h4>Stock Total (Unidades)</h4>
            <div id="val-total-units" class="value">0</div>
          </div>
          <div class="stat-card" style="border-left: 5px solid #059669;">
            <h4>Valorización Total</h4>
            <div id="val-total-money" class="value">$0</div>
          </div>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(450px, 1fr)); gap: 24px; margin-bottom: 32px;">
          <div class="chart-card">
            <h3 style="margin-top: 0; margin-bottom: 20px;">Distribución por Valor (Categoría)</h3>
            <div class="chart-container">
              <canvas id="chart-pie-cats"></canvas>
            </div>
          </div>
          <div class="chart-card">
            <h2 style="margin-top: 0; margin-bottom: 20px; font-size: 1.25rem;">Top 5 Productos más Valiosos</h2>
            <div class="chart-container">
              <canvas id="chart-bar-top"></canvas>
            </div>
          </div>
        </div>

        <div class="card">
          <h3 style="margin-top: 0; margin-bottom: 12px;">Resultados Detallados</h3>
          <div id="report-table-div" style="overflow-x: auto;"></div>
        </div>
      </div>
    </main>

    <script>
      import { getMasterProductos, getStockFiltrado } from "../lib/inventory";
      import { getNegocios } from "../lib/negocios";

      let chartInstPie: any = null;
      let chartInstBar: any = null;
      let cacheMaster: any[] = [];

      const negocioSelect = document.getElementById("report-negocio") as HTMLSelectElement;
      const mesInput = document.getElementById("report-mes") as HTMLInputElement;

      async function init() {
        const now = new Date();
        mesInput.value = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;

        try {
          cacheMaster = await getMasterProductos();
          const negocios = await getNegocios();
          if (negocioSelect) {
            negocioSelect.innerHTML = negocios.map(n => `<option value="${n.nombre}">${n.nombre}</option>`).join("");
          }
        } catch (e) { console.error(e); }
      }

      async function runReport() {
        const nVal = negocioSelect.value;
        const mVal = mesInput.value;
        const msgEl = document.getElementById("no-data-msg");
        const contEl = document.getElementById("report-content");

        if (!nVal || !mVal) return;

        try {
          const stockData = await getStockFiltrado(nVal, mVal);
          
          if (stockData.length === 0) {
            msgEl!.innerHTML = `No se encontraron datos de inventario para <strong>${nVal}</strong> en <strong>${mVal}</strong>.`;
            msgEl!.style.display = "block";
            contEl!.style.display = "none";
            return;
          }

          msgEl!.style.display = "none";
          contEl!.style.display = "block";

          // Unir Stock con Maestro para tener Precios y Nombres Actuales
          const finalReport = stockData.map(s => {
              const master = cacheMaster.find(m => m.codigo === s.codigo);
              const p = master ? master.precio : 0;
              return {
                  codigo: s.codigo,
                  nombre: master ? master.nombre : s.nombre,
                  categoria: master ? (master.categoria || 'Sin Categoría') : 'S/C',
                  precio: p,
                  cantidad: s.cantidad || 0,
                  total: (s.cantidad || 0) * p
              };
          });

          renderCharts(finalReport);
        } catch (e: any) {
          msgEl!.textContent = "Error: " + e.message;
        }
      }

      function renderCharts(data: any[]) {
        if (chartInstPie) chartInstPie.destroy();
        if (chartInstBar) chartInstBar.destroy();

        let totalMoney = 0;
        let totalUnits = 0;
        const catValueMap: Record<string, number> = {};
        
        data.forEach(item => {
           totalMoney += item.total;
           totalUnits += item.cantidad;
           catValueMap[item.categoria] = (catValueMap[item.categoria] || 0) + item.total;
        });

        document.getElementById("val-total-prods")!.textContent = data.length.toLocaleString();
        document.getElementById("val-total-units")!.textContent = totalUnits.toLocaleString();
        document.getElementById("val-total-money")!.textContent = `$${totalMoney.toLocaleString('es-CO')}`;

        const ChartJs = (window as any).Chart;

        // Pie Chart: Categorías
        chartInstPie = new ChartJs(document.getElementById("chart-pie-cats"), {
          type: 'doughnut',
          data: {
            labels: Object.keys(catValueMap),
            datasets: [{
              data: Object.values(catValueMap),
              backgroundColor: ['#3b82f6', '#10b981', '#f59e0b', '#ef4444', '#8b5cf6', '#64748b'],
              borderWidth: 0
            }]
          },
          options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } }
        });

        // Bar Chart: Top 5
        const top5 = [...data].sort((a,b) => b.total - a.total).slice(0, 5);
        chartInstBar = new ChartJs(document.getElementById("chart-bar-top"), {
          type: 'bar',
          data: {
            labels: top5.map(i => i.nombre),
            datasets: [{
              label: 'Valor en Pesos',
              data: top5.map(i => i.total),
              backgroundColor: '#3b82f6',
              borderRadius: 8
            }]
          },
          options: { responsive: true, maintainAspectRatio: false, indexAxis: 'y', plugins: { legend: { display: false } } }
        });

        // Tabla Detallada
        const tableDiv = document.getElementById("report-table-div");
        tableDiv!.innerHTML = `
          <table>
            <thead>
              <tr>
                <th>Cód.</th>
                <th>Nombre del Producto</th>
                <th>Existencia</th>
                <th>Cotización</th>
                <th>Valorización Mes</th>
              </tr>
            </thead>
            <tbody>
              ${data.map(i => `
                <tr>
                  <td><code>${i.codigo}</code></td>
                  <td><strong>${i.nombre}</strong><br/><small style="color:#64748b;">${i.categoria}</small></td>
                  <td>${i.cantidad} und.</td>
                  <td>$${Number(i.precio).toLocaleString()}</td>
                  <td><strong>$${i.total.toLocaleString('es-CO')}</strong></td>
                </tr>
              `).join('')}
            </tbody>
          </table>
        `;
      }

      document.getElementById("btn-generate")?.addEventListener("click", runReport);
      init();
    </script>
  </body>
</html>
