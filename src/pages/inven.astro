---
import Navbar from "../components/navbar.astro";
---

<!DOCTYPE html>
<html lang="es-co">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Gestión de Inventario Mensual</title>
  </head>
  <body>
    <Navbar />

    <div style="margin: 20px;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 15px;">
        <h2>Inventario Mensual</h2>
        
        <div style="display: flex; gap: 10px; align-items: flex-end; background: #f8fafc; padding: 15px; border-radius: 12px; border: 1px solid #e2e8f0;">
          <label style="font-size: 0.85rem; font-weight: 600; color: #64748b;">Filtrar Sede:
            <select id="filter-negocio" style="display: block; padding: 8px; border-radius: 6px; border: 1px solid #cbd5e1; margin-top: 4px;"></select>
          </label>
          <label style="font-size: 0.85rem; font-weight: 600; color: #64748b;">Mes:
            <input type="month" id="filter-mes" style="display: block; padding: 8px; border-radius: 6px; border: 1px solid #cbd5e1; margin-top: 4px;" />
          </label>
          <button id="btn-refresh" style="padding: 10px 20px; background: #3b82f6; color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: 600;">Ver Registros</button>
        </div>
        
        <button id="btn-toggle-form" style="padding: 12px 24px; background-color: #10b981; color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: 700;">
          + Registrar Inventario
        </button>
      </div>

      <div id="form-container" style="display: none; background: #fff; padding: 24px; border-radius: 16px; margin-bottom: 30px; border: 1px solid #e2e8f0; box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);">
        <h3 id="form-title" style="margin-top: 0; margin-bottom: 20px;">Registrar Entrada</h3>
        <form id="form-inven" style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; max-width: 600px;">
          <input type="hidden" name="id" id="inv-id" />
          
          <div style="grid-column: span 2;">
            <label style="font-weight: 600; font-size: 0.9rem;">Producto:</label>
            <select id="inv-producto" name="codigo" required style="width: 100%; padding: 12px; border: 1px solid #cbd5e1; border-radius: 8px; margin-top: 5px;">
              <option value="">Cargando catálogo...</option>
            </select>
            <p style="font-size: 0.75rem; color: #64748b; margin-top: 4px;">* Se tomarán Precio y Categoría de la Base de Datos general.</p>
          </div>

          <div>
            <label style="font-weight: 600; font-size: 0.9rem;">Mes de Registro:</label>
            <input type="month" name="mes" id="inv-mes" required style="width: 100%; padding: 12px; border: 1px solid #cbd5e1; border-radius: 8px; margin-top: 5px;"/>
          </div>

          <div>
            <label style="font-weight: 600; font-size: 0.9rem;">Sede:</label>
            <select id="inv-negocio" name="negocio" required style="width: 100%; padding: 12px; border: 1px solid #cbd5e1; border-radius: 8px; margin-top: 5px;"></select>
          </div>

          <div style="grid-column: span 2;">
            <label style="font-weight: 600; font-size: 0.9rem;">Cantidad Contada:</label>
            <input type="number" name="cantidad" id="inv-cantidad" placeholder="0" required style="width: 100%; padding: 12px; border: 1px solid #cbd5e1; border-radius: 8px; margin-top: 5px;"/>
          </div>

          <div style="grid-column: span 2;">
            <button type="submit" id="btn-submit" style="width: 100%; padding: 14px; background-color: #059669; color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: 700; margin-top: 5px;">
              Guardar en Inventario Mensual
            </button>
          </div>
        </form>
        <p id="msg" style="font-weight: bold; margin-top: 15px;"></p>
      </div>
      
      <div id="results-area">
        <h4 id="list-title" style="margin: 0 0 15px 0; color: #475569; font-weight: 600;">Registros del Mes</h4>
        <div id="lista-inven" style="display: flex; flex-direction: column; gap: 12px;">
          <!-- Items will be injected here -->
          <p style="color: #94a3b8; font-style: italic;">Usa los filtros de arriba para ver los registros.</p>
        </div>
      </div>
    </div>

    <script>
      import { getSession } from "../lib/auth";
      import { getMasterProductos, getStockFiltrado, getStockEntry, addInventario, updateInventario, deleteInventario } from "../lib/inventory";
      import { getNegocios } from "../lib/negocios";

      const now = new Date();
      const defaultMonth = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;
      let masterCache: any[] = [];

      async function init() {
        const session = await getSession();
        if (!session) { window.location.replace("/"); return; }
        
        const filterMes = document.getElementById("filter-mes") as HTMLInputElement;
        const invMes = document.getElementById("inv-mes") as HTMLInputElement;
        filterMes.value = defaultMonth;
        invMes.value = defaultMonth;

        await loadFilters();
        loadData();
      }

      async function loadFilters() {
        try {
          const negocios = await getNegocios();
          masterCache = await getMasterProductos();

          const fNeg = document.getElementById("filter-negocio") as HTMLSelectElement;
          const iNeg = document.getElementById("inv-negocio") as HTMLSelectElement;
          const iProd = document.getElementById("inv-producto") as HTMLSelectElement;

          const negOpts = negocios.map(n => `<option value="${n.nombre}">${n.nombre}</option>`).join("");
          fNeg.innerHTML = negOpts;
          iNeg.innerHTML = negOpts;

          iProd.innerHTML = masterCache.length > 0 
            ? masterCache.map(p => `<option value="${p.codigo}">${p.nombre} (${p.codigo})</option>`).join("")
            : '<option value="">Primero carga la Base de Datos Maestro</option>';

        } catch (e) {
          console.error("Error loading filters:", e);
        }
      }

      async function loadData() {
        const listContainer = document.getElementById("lista-inven")!;
        const fNeg = (document.getElementById("filter-negocio") as HTMLSelectElement).value;
        const fMes = (document.getElementById("filter-mes") as HTMLInputElement).value;

        if (!fNeg || !fMes) return;

        try {
          const data = await getStockFiltrado(fNeg, fMes);
          listContainer.innerHTML = "";

          if (data.length === 0) {
            listContainer.innerHTML = `<div style="padding: 40px; text-align: center; background: #fff; border: 2px dashed #e2e8f0; border-radius: 12px; color: #94a3b8;">No hay registros para <strong>${fNeg}</strong> en <strong>${fMes}</strong>.</div>`;
            return;
          }

          data.forEach(item => {
            const master = masterCache.find(m => m.codigo === item.codigo) || { nombre: "Producto Desconocido", precio: 0 };
            
            const card = document.createElement("div");
            card.style.display = "flex";
            card.style.justifyContent = "space-between";
            card.style.alignItems = "center";
            card.style.padding = "20px";
            card.style.background = "#fff";
            card.style.borderRadius = "12px";
            card.style.border = "1px solid #e2e8f0";
            card.style.boxShadow = "0 1px 2px 0 rgb(0 0 0 / 0.05)";

            card.innerHTML = `
              <div style="flex: 1;">
                <span style="display: block; font-weight: 700; color: #1e293b; font-size: 1.125rem;">${master.nombre}</span>
                <span style="font-size: 0.875rem; color: #64748b; font-family: monospace;">COD: ${item.codigo}</span>
              </div>
              <div style="text-align: right; margin-right: 24px;">
                <span style="display: block; font-size: 1.5rem; font-weight: 800; color: #0f172a;">${item.cantidad}</span>
                <span style="font-size: 0.75rem; color: #64748b; text-transform: uppercase; font-weight: 600;">Unidades</span>
              </div>
              <div style="display: flex; gap: 8px;">
                <button class="btn-edit" 
                  data-id="${item.id}" 
                  data-codigo="${item.codigo}" 
                  data-cantidad="${item.cantidad}" 
                  data-negocio="${item.negocio}" 
                  data-mes="${item.mes}"
                  style="padding: 8px 12px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 6px; cursor: pointer; font-size: 0.875rem;">Editar</button>
                <button class="btn-delete" 
                  data-id="${item.id}"
                  style="padding: 8px 12px; background: #fef2f2; color: #ef4444; border: 1px solid #fee2e2; border-radius: 6px; cursor: pointer; font-size: 0.875rem;">Eliminar</button>
              </div>
            `;
            listContainer.appendChild(card);
          });

          // Handlers
          document.querySelectorAll('.btn-edit').forEach(btn => {
            btn.addEventListener('click', (e: any) => {
              const d = e.target.dataset;
              (document.getElementById("inv-id") as HTMLInputElement).value = d.id;
              (document.getElementById("inv-producto") as HTMLSelectElement).value = d.codigo;
              (document.getElementById("inv-negocio") as HTMLSelectElement).value = d.negocio;
              (document.getElementById("inv-mes") as HTMLInputElement).value = d.mes;
              (document.getElementById("inv-cantidad") as HTMLInputElement).value = d.cantidad;
              
              const formC = document.getElementById("form-container");
              if (formC) formC.style.display = "block";
              (document.getElementById("btn-toggle-form") as HTMLButtonElement).textContent = "- Cancelar Edición";
              document.getElementById("form-title")!.textContent = "Editar Entrada de Inventario";
              window.scrollTo({ top: 0, behavior: 'smooth' });
            });
          });

          document.querySelectorAll('.btn-delete').forEach(btn => {
            btn.addEventListener('click', async (e: any) => {
              if (confirm("¿Eliminar este registro del inventario mensual?")) {
                await deleteInventario(e.target.dataset.id);
                loadData();
              }
            });
          });

        } catch (e: any) {
          listContainer.innerHTML = `<p style="color: red;">Error: ${e.message}</p>`;
        }
      }

      const btnToggle = document.getElementById("btn-toggle-form");
      const formContainer = document.getElementById("form-container");

      btnToggle?.addEventListener("click", () => {
        if (formContainer?.style.display === "none") {
          formContainer.style.display = "block";
          btnToggle.textContent = "- Cancelar";
        } else {
          formContainer!.style.display = "none";
          btnToggle!.textContent = "+ Registrar Inventario";
          (document.getElementById("form-inven") as HTMLFormElement).reset();
          (document.getElementById("inv-id") as HTMLInputElement).value = "";
          (document.getElementById("inv-mes") as HTMLInputElement).value = defaultMonth;
          document.getElementById("form-title")!.textContent = "Registrar Entrada";
        }
      });

      document.getElementById("btn-refresh")?.addEventListener("click", loadData);

      const form = document.getElementById("form-inven") as HTMLFormElement;
      form?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const msg = document.getElementById("msg")!;
        const fd = new FormData(form);
        const id = fd.get("id") as string;
        const codigo = fd.get("codigo") as string;
        const master = masterCache.find(p => p.codigo === codigo);

        const payload = {
          nombre: master ? master.nombre : "Sin nombre",
          codigo: codigo,
          negocio: fd.get("negocio") as string,
          mes: fd.get("mes") as string,
          cantidad: parseInt(fd.get("cantidad") as string) || 0
        };

        try {
          if (id) {
            await updateInventario(id, payload);
          } else {
            // Verificar duplicados para el mismo mes/sede
            const existing = await getStockEntry(payload.codigo, payload.negocio, payload.mes);
            if (existing) {
              if (confirm("Este producto ya tiene un registro para este mes/sede. ¿Deseas sumar la nueva cantidad?")) {
                await updateInventario(existing.id, { cantidad: existing.cantidad + payload.cantidad });
              } else return;
            } else {
              await addInventario(payload);
            }
          }
          
          msg.textContent = "✓ Registro guardado correctamente.";
          msg.style.color = "#059669";
          form.reset();
          loadData();
          setTimeout(() => { 
            msg.textContent = ""; 
            btnToggle?.click();
          }, 1500);
        } catch (e: any) {
          msg.textContent = "Error: " + e.message;
          msg.style.color = "#ef4444";
        }
      });

      init();
    </script>
  </body>
</html>
