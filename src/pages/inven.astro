---
import Navbar from "../components/navbar.astro";
---

<!DOCTYPE html>
<html lang="es-co">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Inventario | Gestión Premium</title>
    
    <!-- Premium Font: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <style>
      body { font-family: 'Inter', system-ui, -apple-system, sans-serif; background-color: #f8fafc; margin: 0; color: #0f172a; }
      .container { padding: 40px 24px; max-width: 1000px; margin: 0 auto; }
      
      .header-flex { display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px; }
      h1 { margin: 0; font-size: 2rem; font-weight: 800; color: #0f172a; letter-spacing: -0.04em; }
      
      .btn-toggle { 
        padding: 12px 28px; background: linear-gradient(135deg, #10b981 0%, #059669 100%); 
        color: white; border: none; border-radius: 14px; cursor: pointer; font-weight: 800; 
        transition: all 0.3s; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
      }
      .btn-toggle:hover { transform: translateY(-2px); box-shadow: 0 12px 20px rgba(16, 185, 129, 0.4); }
      
      /* Formulario Moderno */
      .form-card { background: white; padding: 32px; border-radius: 28px; border: 1px solid #e2e8f0; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.05); margin-bottom: 40px; }
      .form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; }
      .form-group { display: flex; flex-direction: column; gap: 8px; }
      label { font-size: 0.75rem; font-weight: 800; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em; }
      input, select { padding: 14px; border: 1px solid #e2e8f0; border-radius: 12px; font-size: 1rem; background: #f8fafc; transition: all 0.2s; }
      input:focus { outline: none; border-color: #3b82f6; box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1); background: white; }
      .btn-submit { width: 100%; padding: 16px; background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); color: white; border: none; border-radius: 14px; cursor: pointer; font-weight: 800; margin-top: 24px; box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3); }

      /* Filtros */
      .filter-section { background: white; padding: 20px; border-radius: 20px; border: 1px solid #e2e8f0; margin-bottom: 32px; display: flex; gap: 16px; align-items: flex-end; flex-wrap: wrap; }
      .btn-search { padding: 12px 24px; background: #475569; color: white; border: none; border-radius: 12px; cursor: pointer; font-weight: 700; transition: all 0.2s; }
      .btn-search:hover { background: #1e293b; }

      /* LISTA DE TARJETAS (REQUISITOS DEL USUARIO) */
      #lista-inventario { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 28px; }
      
      .inventory-card { 
        background: white; padding: 32px; border-radius: 28px; border: 1px solid #f1f5f9; 
        display: flex; justify-content: space-between; align-items: center; gap: 24px;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05), 0 4px 6px -2px rgba(0, 0, 0, 0.02); 
        position: relative; overflow: hidden; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      }
      .inventory-card:hover { 
        transform: translateY(-6px); 
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04); 
        border-color: #06b6d4; 
      }
      /* Acento de color lateral */
      .inventory-card::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 8px; background: #06b6d4; }

      /* Contenido de la Tarjeta */
      .card-info { flex: 1; display: flex; flex-direction: column; gap: 6px; }
      .prod-name { font-size: 1.25rem; font-weight: 800; color: #0f172a; letter-spacing: -0.02em; }
      .prod-sku { font-family: monospace; font-size: 0.85rem; color: #64748b; background: #f1f5f9; padding: 2px 8px; border-radius: 6px; width: fit-content; }
      
      .card-stats { display: flex; align-items: baseline; gap: 20px; }
      .price-tag { color: #059669; font-weight: 800; font-size: 1.2rem; }
      .qty-tag { color: #64748b; font-size: 1rem; font-weight: 500; }
      .qty-val { color: #0f172a; font-weight: 800; }

      /* Botones alineados (Requisito) */
      .card-actions { display: flex; gap: 12px; align-items: center; }
      .btn-edit { 
        padding: 10px 20px; background: #f1f5f9; color: #3b82f6; border: none; border-radius: 12px; 
        cursor: pointer; font-weight: 800; font-size: 0.9rem; transition: all 0.2s;
      }
      .btn-edit:hover { background: #eff6ff; transform: scale(1.05); }
      
      .btn-delete { 
        padding: 10px 20px; background: #fef2f2; color: #ef4444; border: none; border-radius: 12px; 
        cursor: pointer; font-weight: 800; font-size: 0.9rem; transition: all 0.2s;
      }
      .btn-delete:hover { background: #fee2e2; transform: scale(1.05); }

      #msg { text-align: center; font-weight: 700; margin-top: 10px; }

      .context-hint {
        font-size: 0.95rem;
        color: #64748b;
        margin: -16px 0 24px 0;
        font-weight: 600;
      }
      .context-hint strong { color: #0f172a; }

      .page-hero {
        background: linear-gradient(135deg, #ecfeff 0%, #f0f9ff 50%, #f8fafc 100%);
        border: 1px solid #e0f2fe;
        border-radius: 24px;
        padding: 28px 32px;
        margin-bottom: 28px;
        position: relative;
        overflow: hidden;
      }
      .page-hero::after {
        content: "";
        position: absolute;
        top: 0;
        right: 0;
        width: 180px;
        height: 100%;
        background: radial-gradient(ellipse at top right, rgba(14, 165, 233, 0.12), transparent 70%);
        pointer-events: none;
      }
      .page-hero__badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 0.7rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: #0369a1;
        background: rgba(255, 255, 255, 0.9);
        border: 1px solid #bae6fd;
        padding: 6px 12px;
        border-radius: 999px;
        margin-bottom: 12px;
      }
      .page-hero__badge::before {
        content: "";
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #06b6d4;
        box-shadow: 0 0 0 3px rgba(6, 182, 212, 0.25);
      }
      .page-hero__title {
        margin: 0 0 8px 0;
        font-size: 1.75rem;
        font-weight: 800;
        color: #0f172a;
        letter-spacing: -0.03em;
      }
      .page-hero__desc {
        margin: 0;
        font-size: 0.95rem;
        color: #64748b;
        line-height: 1.55;
        max-width: 52ch;
      }
    </style>
  </head>
  <body>
    <Navbar />
    
    <div class="container">
      <header class="page-hero">
        <span class="page-hero__badge">Base de datos · Operación</span>
        <h2 class="page-hero__title">Inventario por sede y mes</h2>
        <p class="page-hero__desc">
          Aquí consultas y registras <strong>existencias reales</strong> (filas en la base). Los gráficos y totales agregados están en <strong>Análisis → Reportes inventario</strong>.
        </p>
      </header>

      <div class="header-flex">
        <h1>Inventario Mensual</h1>
        <button id="btn-toggle-form" class="btn-toggle">+ Registrar Stock</button>
      </div>

      <p id="context-inv" class="context-hint" style="display: none;"></p>

      <div id="form-container" class="form-card" style="display: none;">
        <form id="form-stock">
          <div class="form-grid">
            <div class="form-group">
                <label>Sede / Negocio</label>
                <select id="s-negocio" required></select>
            </div>
            <div class="form-group">
                <label>Mes</label>
                <input type="month" id="s-mes" required />
            </div>
            <div class="form-group">
                <label>Producto (Código)</label>
                <input type="text" id="s-codigo" placeholder="SKU..." list="master-codes" required />
                <datalist id="master-codes"></datalist>
            </div>
            <div class="form-group">
                <label>Cantidad Actual</label>
                <input type="number" id="s-cantidad" placeholder="0" required />
            </div>
          </div>
          <button type="submit" class="btn-submit">Guardar Registro Mensual</button>
        </form>
        <p id="msg"></p>
      </div>

      <div class="filter-section">
        <div class="form-group" style="flex: 1;">
            <label>Filtrar Sede</label>
            <select id="filter-negocio"></select>
        </div>
        <div class="form-group" style="flex: 1;">
            <label>Filtrar Mes</label>
            <input type="month" id="filter-mes" />
        </div>
        <button id="btn-search" class="btn-search">Actualizar</button>
      </div>

      <ul id="lista-inventario">
        <li style="text-align: center; color: #94a3b8; padding: 60px;">Cargando...</li>
      </ul>
    </div>

    <script>
      import { getSession } from "../lib/auth";
      import { getStockFiltrado, addStockEntry, getMasterProductos, deleteRegistro } from "../lib/inventory";
      import { getNegocios } from "../lib/negocios";

      async function init() {
        const session = await getSession();
        if (!session) { window.location.replace("/"); return; }

        const now = new Date();
        const curM = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;
        (document.getElementById("s-mes") as HTMLInputElement).value = curM;
        (document.getElementById("filter-mes") as HTMLInputElement).value = curM;

        await Promise.all([loadNegocios(), loadMasterCodes()]);
        loadData();
      }

      async function loadNegocios() {
        const negs = await getNegocios();
        ["s-negocio", "filter-negocio"].forEach(id => {
          const el = document.getElementById(id) as HTMLSelectElement;
          el.innerHTML = negs.map(n => `<option value="${n.nombre}">${n.nombre}</option>`).join("");
        });
      }

      async function loadMasterCodes() {
        const codes = await getMasterProductos();
        document.getElementById("master-codes")!.innerHTML = codes.map(p => `<option value="${p.codigo}">${p.nombre}</option>`).join("");
      }

      async function loadData() {
        const lista = document.getElementById("lista-inventario")!;
        const fNeg = (document.getElementById("filter-negocio") as HTMLSelectElement).value;
        const fMes = (document.getElementById("filter-mes") as HTMLInputElement).value;
        const hint = document.getElementById("context-inv")!;

        if (!fNeg || !fMes) {
          hint.style.display = "none";
          lista.innerHTML = `<li style="text-align: center; padding: 60px; color: #94a3b8;">Selecciona sede y mes para ver el inventario de ese negocio.</li>`;
          return;
        }

        hint.innerHTML = `Mostrando inventario de: <strong>${fNeg}</strong> · mes <strong>${fMes}</strong>`;
        hint.style.display = "block";

        try {
          const data = await getStockFiltrado(fNeg, fMes);
          (document.getElementById("s-negocio") as HTMLSelectElement).value = fNeg;
          (document.getElementById("s-mes") as HTMLInputElement).value = fMes;

          lista.innerHTML = data.length ? "" : `<li style="text-align: center; padding: 60px; color: #94a3b8;">No hay registros para este negocio en este mes.</li>`;
          
          data.forEach(item => {
            const li = document.createElement("li");
            li.className = "inventory-card";
            li.innerHTML = `
              <div class="card-info">
                <span class="prod-name">${item.nombre}</span>
                <span class="prod-sku">${item.codigo}</span>
                <div class="card-stats">
                  <span class="price-tag">$${Number(item.precio || 0).toLocaleString()}</span>
                  <span class="qty-tag">Stock: <span class="qty-val">${item.cantidad}</span> und.</span>
                </div>
              </div>
              <div class="card-actions">
                <button class="btn-edit" onclick="alert('Función de edición en desarrollo')">Editar</button>
                <button class="btn-delete" data-id="${item.id}" data-nombre="${item.nombre}">Eliminar</button>
              </div>
            `;
            lista.appendChild(li);
          });

          document.querySelectorAll('.btn-delete').forEach(btn => {
            btn.addEventListener('click', async (e: any) => {
              if (confirm(`¿Eliminar "${e.target.dataset.nombre}"?`)) {
                await deleteRegistro(e.target.dataset.id);
                loadData();
              }
            });
          });
        } catch (e) { console.error(e); }
      }

      // UI Logic
      const toggleBtn = document.getElementById("btn-toggle-form")!;
      const cont = document.getElementById("form-container")!;
      toggleBtn.addEventListener("click", () => {
        const isHidden = cont.style.display === "none";
        cont.style.display = isHidden ? "block" : "none";
        toggleBtn.textContent = isHidden ? "- Ocultar Formulario" : "+ Registrar Stock";
        toggleBtn.style.background = isHidden ? "#ef4444" : "linear-gradient(135deg, #10b981 0%, #059669 100%)";
      });

      document.getElementById("btn-search")?.addEventListener("click", loadData);
      document.getElementById("form-stock")?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const msg = document.getElementById("msg")!;
        const btn = (e.target as HTMLFormElement).querySelector('button[type="submit"]') as HTMLButtonElement;
        
        try {
          msg.textContent = "Guardando...";
          btn.disabled = true;
          await addStockEntry({
            codigo: (document.getElementById("s-codigo") as HTMLInputElement).value,
            cantidad: parseInt((document.getElementById("s-cantidad") as HTMLInputElement).value),
            negocio: (document.getElementById("s-negocio") as HTMLSelectElement).value,
            mes: (document.getElementById("s-mes") as HTMLInputElement).value
          });
          msg.textContent = "✓ Guardado con éxito";
          msg.style.color = "#10b981";
          (document.getElementById("s-cantidad") as HTMLInputElement).value = "";
          loadData();
          setTimeout(() => { msg.textContent = ""; toggleBtn.click(); btn.disabled = false; }, 1500);
        } catch (err: any) {
          msg.textContent = "Error: " + err.message;
          msg.style.color = "#ef4444";
          btn.disabled = false;
        }
      });

      init();
    </script>
  </body>
</html>
