---
import Navbar from "../components/navbar.astro";
---

<!DOCTYPE html>
<html lang="es-co">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Productos | Base de Datos Premium</title>
    
    <!-- Premium Font: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <style>
      body { font-family: 'Inter', system-ui, -apple-system, sans-serif; background-color: #f8fafc; margin: 0; color: #0f172a; }
      .container { padding: 40px 24px; max-width: 1000px; margin: 0 auto; }
      
      .header-flex { display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px; }
      h1 { margin: 0; font-size: 2rem; font-weight: 800; color: #0f172a; letter-spacing: -0.04em; }
      
      .btn-toggle { 
        padding: 12px 28px; background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); 
        color: white; border: none; border-radius: 14px; cursor: pointer; font-weight: 800; 
        transition: all 0.3s; box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
      }
      .btn-toggle:hover { transform: translateY(-2px); box-shadow: 0 12px 20px rgba(59, 130, 246, 0.4); }
      
      .form-card { background: white; padding: 32px; border-radius: 28px; border: 1px solid #e2e8f0; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.05); margin-bottom: 40px; }
      .form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; }
      .form-group { display: flex; flex-direction: column; gap: 8px; }
      label { font-size: 0.75rem; font-weight: 800; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em; }
      input, select { padding: 14px; border: 1px solid #e2e8f0; border-radius: 12px; font-size: 1rem; background: #f8fafc; transition: all 0.2s; }
      input:focus { outline: none; border-color: #3b82f6; box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1); background: white; }
      .btn-submit { width: 100%; padding: 16px; background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); color: white; border: none; border-radius: 14px; cursor: pointer; font-weight: 800; margin-top: 24px; box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3); }

      /* LISTA DE TARJETAS (REQUISITOS DEL USUARIO) */
      #lista-productos { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 28px; }
      
      .producto-card { 
        background: white; padding: 32px; border-radius: 28px; border: 1px solid #f1f5f9; 
        display: flex; justify-content: space-between; align-items: center; gap: 24px;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05), 0 4px 6px -2px rgba(0, 0, 0, 0.02); 
        position: relative; overflow: hidden; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      }
      .producto-card:hover { transform: translateY(-6px); box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1); border-color: #3b82f6; }
      .producto-card::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 8px; background: #3b82f6; }

      .card-info { flex: 1; display: flex; flex-direction: column; gap: 6px; }
      .prod-name { font-size: 1.25rem; font-weight: 800; color: #0f172a; letter-spacing: -0.02em; }
      .prod-sku { font-family: monospace; font-size: 0.85rem; color: #64748b; background: #f1f5f9; padding: 2px 8px; border-radius: 6px; width: fit-content; }
      .price-tag { color: #059669; font-weight: 800; font-size: 1.2rem; }

      .card-actions { display: flex; gap: 12px; align-items: center; }
      .btn-edit { padding: 10px 20px; background: #f1f5f9; color: #3b82f6; border: none; border-radius: 12px; cursor: pointer; font-weight: 800; font-size: 0.9rem; transition: all 0.2s; }
      .btn-edit:hover { background: #eff6ff; transform: scale(1.05); }
      .btn-delete { padding: 10px 20px; background: #fef2f2; color: #ef4444; border: none; border-radius: 12px; cursor: pointer; font-weight: 800; font-size: 0.9rem; transition: all 0.2s; }
      .btn-delete:hover { background: #fee2e2; transform: scale(1.05); }

      #msg { text-align: center; font-weight: 700; margin-top: 10px; }

      .page-hero {
        background: linear-gradient(135deg, #eff6ff 0%, #f8fafc 100%);
        border: 1px solid #bfdbfe;
        border-radius: 24px;
        padding: 24px 28px;
        margin-bottom: 28px;
      }
      .page-hero__badge {
        display: inline-block;
        font-size: 0.68rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: #1d4ed8;
        background: #fff;
        border: 1px solid #93c5fd;
        padding: 6px 12px;
        border-radius: 999px;
        margin-bottom: 10px;
      }
      .page-hero__title { margin: 0 0 8px 0; font-size: 1.35rem; font-weight: 800; color: #0f172a; letter-spacing: -0.02em; }
      .page-hero__desc { margin: 0; font-size: 0.92rem; color: #64748b; line-height: 1.5; max-width: 56ch; }
    </style>
  </head>
  <body>
    <Navbar />
    <div class="container">
      <header class="page-hero">
        <span class="page-hero__badge">Base de datos · Catálogo</span>
        <h2 class="page-hero__title">Maestro de productos</h2>
        <p class="page-hero__desc">
          Define precios y referencias. El inventario mensual por sede lo gestionas en <strong>Inventario</strong>; los gráficos en <strong>Análisis → Reportes inventario</strong>.
        </p>
      </header>

      <div class="header-flex">
        <h1>Base de Datos de Productos</h1>
        <button id="btn-toggle-form" class="btn-toggle">+ Nuevo Producto</button>
      </div>

      <div id="form-container" class="form-card" style="display: none;">
        <form id="form-producto">
          <div class="form-grid">
            <div class="form-group">
                <label>Nombre del Producto</label>
                <input type="text" id="p-nombre" placeholder="Ej: Camiseta Azul" required />
            </div>
            <div class="form-group">
                <label>Código (SKU)</label>
                <input type="text" id="p-codigo" placeholder="SKU-001" required />
            </div>
            <div class="form-group">
                <label>Precio Unitario</label>
                <input type="number" id="p-precio" placeholder="0" required />
            </div>
          </div>
          <button type="submit" class="btn-submit">Registrar Producto</button>
        </form>
        <p id="msg"></p>
      </div>

      <ul id="lista-productos">
        <li style="text-align: center; color: #94a3b8; padding: 60px;">Cargando productos...</li>
      </ul>
    </div>

    <script>
      import { getSession } from "../lib/auth";
      import { getMasterProductos, upsertMasterProducto, deleteMasterProducto } from "../lib/inventory";

      async function init() {
        const session = await getSession();
        if (!session) { window.location.replace("/"); return; }
        loadData();
      }

      async function loadData() {
        const lista = document.getElementById("lista-productos")!;
        try {
          const data = await getMasterProductos();
          lista.innerHTML = data.length ? "" : `<li style="text-align: center; padding: 60px; color: #94a3b8;">No hay productos registrados.</li>`;
          
          data.forEach(item => {
            const li = document.createElement("li");
            li.className = "producto-card";
            li.innerHTML = `
              <div class="card-info">
                <span class="prod-name">${item.nombre}</span>
                <span class="prod-sku">${item.codigo}</span>
                <span class="price-tag">$${Number(item.precio || 0).toLocaleString()}</span>
              </div>
              <div class="card-actions">
                <button class="btn-edit" onclick="alert('Función de edición en desarrollo')">Editar</button>
                <button class="btn-delete" data-id="${item.id}" data-nombre="${item.nombre}">Eliminar</button>
              </div>
            `;
            lista.appendChild(li);
          });

          document.querySelectorAll('.btn-delete').forEach(btn => {
            btn.addEventListener('click', async (e: any) => {
              const target = e.target as HTMLButtonElement;
              if (confirm(`¿Eliminar "${target.dataset.nombre}"?`)) {
                await deleteMasterProducto(target.dataset.id!);
                loadData();
              }
            });
          });
        } catch (e) { console.error(e); }
      }

      const toggleBtn = document.getElementById("btn-toggle-form")!;
      const cont = document.getElementById("form-container")!;
      toggleBtn.addEventListener("click", () => {
        const isHidden = cont.style.display === "none";
        cont.style.display = isHidden ? "block" : "none";
        toggleBtn.textContent = isHidden ? "- Ocultar Formulario" : "+ Nuevo Producto";
        toggleBtn.style.background = isHidden ? "#ef4444" : "linear-gradient(135deg, #3b82f6 0%, #2563eb 100%)";
      });

      document.getElementById("form-producto")?.addEventListener("submit", async (e: any) => {
        e.preventDefault();
        const msg = document.getElementById("msg")!;
        try {
          msg.textContent = "Guardando...";
          await upsertMasterProducto({
            nombre: (document.getElementById("p-nombre") as HTMLInputElement).value,
            codigo: (document.getElementById("p-codigo") as HTMLInputElement).value,
            precio: parseFloat((document.getElementById("p-precio") as HTMLInputElement).value),
            categoria: "" // Categoría opcional
          });
          msg.textContent = "✓ Guardado con éxito";
          msg.style.color = "#10b981";
          e.target.reset();
          loadData();
          setTimeout(() => { msg.textContent = ""; toggleBtn.click(); }, 1500);
        } catch (err: any) {
          msg.textContent = "Error: " + err.message;
          msg.style.color = "#ef4444";
        }
      });

      init();
    </script>
  </body>
</html>
