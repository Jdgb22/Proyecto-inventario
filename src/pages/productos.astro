---
import Navbar from "../components/navbar.astro";
---

<!DOCTYPE html>
<html lang="es-co">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Base de Datos de Productos</title>
  </head>
  <body>
    <Navbar />

    <div style="margin: 20px;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <h2>Base de Datos de Productos</h2>
        <button id="btn-toggle-form" style="padding: 10px 20px; background-color: #4CAF50; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; transition: all 0.2s;">
          + Nuevo Producto
        </button>
      </div>

      <div id="form-container" style="display: none; background: #f3f4f6; padding: 24px; border-radius: 12px; margin-bottom: 30px; border: 1px solid #e5e7eb;">
        <h3 id="form-title" style="margin-top: 0; margin-bottom: 15px; color: #111827;">Registrar Producto Maestro</h3>
        <form id="form-productos" style="display: flex; flex-direction: column; gap: 10px; max-width: 400px;">
          <input type="hidden" name="id" id="prod-id" />
          
          <input type="text" name="nombre" id="prod-nombre" placeholder="Nombre completo del producto" required style="padding: 10px; border: 1px solid #ccc; border-radius: 4px;"/>
          
          <input type="text" name="codigo" id="prod-codigo" placeholder="Código Único (SKU)" required style="padding: 10px; border: 1px solid #ccc; border-radius: 4px;"/>

          <label style="font-size: 0.85rem; color: #64748b; margin-top: 5px;">Precio:</label>
          <input type="number" name="precio" id="prod-precio" placeholder="0.00" step="0.01" style="padding: 10px; border: 1px solid #ccc; border-radius: 4px;"/>

          <label style="font-size: 0.85rem; color: #64748b;">Categoría:</label>
          <input type="text" name="categoria" id="prod-categoria" placeholder="Categoría" style="padding: 10px; border: 1px solid #ccc; border-radius: 4px;"/>

          <button type="submit" id="btn-submit" style="padding: 12px; background-color: #3b82f6; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; margin-top: 10px;">
            Guardar en Base de Datos
          </button>
        </form>
        <p id="msg" style="font-weight: bold; margin-top: 10px;"></p>
      </div>
      
      <div style="margin-top: 20px;">
        <h4 style="margin: 0 0 12px 0; color: #64748b;">Catálogo Maestro</h4>
        <div class="table-responsive" style="overflow-x: auto; background: white; border-radius: 8px; border: 1px solid #e5e7eb;">
          <table style="width: 100%; border-collapse: collapse; text-align: left;">
            <thead style="background: #f8fafc; border-bottom: 2px solid #e5e7eb;">
              <tr>
                <th style="padding: 12px;">Código</th>
                <th style="padding: 12px;">Nombre</th>
                <th style="padding: 12px;">Categoría</th>
                <th style="padding: 12px;">Precio</th>
                <th style="padding: 12px;">Acciones</th>
              </tr>
            </thead>
            <tbody id="lista-productos">
              <tr><td colspan="5" style="padding: 20px; text-align: center;">Cargando...</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <script>
      import { getSession } from "../lib/auth";
      import { getMasterProductos, upsertMasterProducto, deleteInventario } from "../lib/inventory";

      async function checkAuth() {
        const session = await getSession();
        if (!session) { window.location.replace("/"); return; }
        loadProducts();
      }

      async function loadProducts() {
        const tbody = document.getElementById("lista-productos");
        if (!tbody) return;

        try {
          const data = await getMasterProductos();
          tbody.innerHTML = "";
          
          if (data.length === 0) {
            tbody.innerHTML = "<tr><td colspan='5' style='padding: 20px; text-align: center; color: #64748b;'>No hay productos definidos.</td></tr>";
            return;
          }
          
          data.forEach(item => {
            const tr = document.createElement("tr");
            tr.style.borderBottom = "1px solid #f1f5f9";
            tr.innerHTML = `
              <td style="padding: 12px; font-family: monospace;">${item.codigo}</td>
              <td style="padding: 12px; font-weight: 500;">${item.nombre}</td>
              <td style="padding: 12px; color: #64748b;">${item.categoria || '-'}</td>
              <td style="padding: 12px; color: #059669; font-weight: bold;">$${Number(item.precio || 0).toLocaleString()}</td>
              <td style="padding: 12px; display: flex; gap: 8px;">
                <button class="btn-edit" 
                  data-id="${item.id}" 
                  data-nombre="${item.nombre}" 
                  data-codigo="${item.codigo}" 
                  data-precio="${item.precio || ''}" 
                  data-categoria="${item.categoria || ''}"
                  style="padding: 4px 8px; background: #f59e0b; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 0.8rem;">Editar</button>
                <button class="btn-delete" 
                  data-id="${item.id}" 
                  style="padding: 4px 8px; background: #ef4444; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 0.8rem;">Borrar</button>
              </td>
            `;
            tbody.appendChild(tr);
          });

          // Delete handler
          document.querySelectorAll('.btn-delete').forEach(btn => {
            btn.addEventListener('click', async (e: any) => {
              if (confirm("¿Eliminar este producto de la base de datos maestra?")) {
                await deleteInventario(e.target.dataset.id);
                loadProducts();
              }
            });
          });

          // Edit handler
          document.querySelectorAll('.btn-edit').forEach(btn => {
            btn.addEventListener('click', (e: any) => {
              const d = e.target.dataset;
              (document.getElementById("prod-id") as HTMLInputElement).value = d.id;
              (document.getElementById("prod-nombre") as HTMLInputElement).value = d.nombre;
              (document.getElementById("prod-codigo") as HTMLInputElement).value = d.codigo;
              (document.getElementById("prod-precio") as HTMLInputElement).value = d.precio;
              (document.getElementById("prod-categoria") as HTMLInputElement).value = d.categoria;
              
              const formC = document.getElementById("form-container");
              if (formC) formC.style.display = "block";
              (document.getElementById("btn-toggle-form") as HTMLButtonElement).textContent = "- Cerrar";
            });
          });

        } catch (error: any) {
          tbody.innerHTML = `<tr><td colspan='5' style='color: red;'>Error: ${error.message}</td></tr>`;
        }
      }

      const btnToggle = document.getElementById("btn-toggle-form");
      const formContainer = document.getElementById("form-container");

      btnToggle?.addEventListener("click", () => {
        if (formContainer?.style.display === "none") {
          formContainer.style.display = "block";
          btnToggle.textContent = "- Cerrar";
        } else {
          formContainer!.style.display = "none";
          btnToggle!.textContent = "+ Nuevo Producto";
          (document.getElementById("form-productos") as HTMLFormElement).reset();
          (document.getElementById("prod-id") as HTMLInputElement).value = "";
        }
      });

      const form = document.getElementById("form-productos") as HTMLFormElement;
      form?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const msg = document.getElementById("msg")!;
        const fd = new FormData(form);

        const payload = {
          nombre: fd.get("nombre") as string,
          codigo: fd.get("codigo") as string,
          precio: parseFloat(fd.get("precio") as string) || 0,
          categoria: fd.get("categoria") as string
        };

        try {
          await upsertMasterProducto(payload);
          msg.textContent = "¡Base de datos actualizada!";
          msg.style.color = "green";
          form.reset();
          loadProducts();
          setTimeout(() => { 
            msg.textContent = ""; 
            btnToggle?.click();
          }, 1500);
        } catch (e: any) {
          msg.textContent = "Error: " + e.message;
          msg.style.color = "red";
        }
      });

      checkAuth();
    </script>
  </body>
</html>
